{
  "name": "16-bit-con",
  "version": "0.1.0",
  "description": "16-Bit Con: a landing page for a retro gaming convention, with a pixel-art game on a 3D monitor. Astro, TypeScript, plain CSS.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "format": "prettier --write src scripts \"*.{mjs,json}\"",
    "format:check": "prettier --check src scripts \"*.{mjs,json}\"",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "gsap": "^3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "0.187.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
