---
/**
 * /dev/sound — the game's sounds, the cracks stage by stage, and sliders for the numbers to tune by ear.
 * Dev only: injected by astro.config.mjs under `astro dev`, never built. It drives src/game/sound.ts
 * itself, so what plays here is what the game plays.
 */
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import Button from '../components/Button.astro';

/** [file, name, what it sounds like, picked to start with] — the game's crack files. */
const SOUNDS: [string, string, string, boolean][] = [
  ['crack-4', 'crack-4', '— one tiny bright tick', true],
  ['crack-3', 'crack-3', '— a short run of ticks', true],
  ['glass-1', '#1', '— a dense, spreading crackle', true],
  ['glass-3', '#3', '— spaced ticks, a longer crack-3', true],
];
---

<Base title="Sound · dev" footer={false} noindex>
  <main class="dev-sound" id="main">
    <Window title="Sounds" class="dev-sound__win">
      <div class="dev-sound__row">
        <Button variant="ghost" data-play="enter">Enter</Button>
        <Button variant="ghost" data-play="exit">Exit</Button>
        <Button variant="ghost" data-play="shatter">Shatter</Button>
        <Button variant="ghost" data-play="static">Static</Button>
        <Button variant="ghost" data-play="power-off">Power off</Button>
        <Button variant="ghost" data-play="power-on">Power on</Button>
        <span class="dev-sound__spacer"></span>
        <Button variant="ghost" data-stop>Stop all</Button>
      </div>
    </Window>

    <Window title="Cracks" class="dev-sound__win">
      <div class="dev-sound__group">
        <h2 class="mono dev-sound__heading">1 · Pick the sounds</h2>
        <ul class="dev-sound__picks">
          {
            SOUNDS.map(([f, name, what, on]) => (
              <li class="dev-sound__pick">
                <Button variant="ghost" data-try={f} aria-label={`Play ${name}`}>Play</Button>
                <label class="mono dev-sound__label dev-sound__field">
                  <input type="checkbox" data-use={f} checked={on} />
                  <span><strong>{name}</strong> {what}</span>
                </label>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="dev-sound__group">
        <h2 class="mono dev-sound__heading">2 · Order them</h2>
        <div class="dev-sound__stages" data-stages></div>
        <div class="dev-sound__row">
          <Button data-run>Play six cracks + shatter</Button>
          <label class="mono dev-sound__label dev-sound__field">
            Pace
            <select class="mono dev-sound__select" data-pace>
              <option value="380" selected>380 ms, auto hits</option>
              <option value="250">250 ms, fast clicks</option>
              <option value="600">600 ms, slow</option>
            </select>
          </label>
        </div>
        <div class="dev-sound__row">
          <Button variant="ghost" data-now>Back to the game's order</Button>
          <Button variant="ghost" data-copy-order>Copy picks and order</Button>
          <span class="mono dev-sound__status" data-status aria-live="polite"></span>
        </div>
      </div>
      <p class="mono dev-sound__note">#1 and #3 are raised to the others' loudness and faded where they cut off. Cut = the first 320 ms, faded out by 380 ms, the gap between auto hits.</p>
    </Window>

    <Window title="Numbers" class="dev-sound__win">
      <div class="dev-sound__sliders" data-sliders></div>
      <div class="dev-sound__row dev-sound__row--end">
        <Button variant="ghost" data-reset>Defaults</Button>
        <Button variant="ghost" data-copy>Copy values</Button>
      </div>
    </Window>
  </main>
</Base>

<script>
  import * as sound from '../game/sound';
  import { PLAY, playMs } from '../game/segments';

  type Key = keyof typeof sound.params;
  /** [key, label, min, max, step, unit], in groups. */
  const GROUPS: [string, [Key, string, number, number, number, string][]][] = [
    ['All', [['master', 'Master volume', 0, 1, 0.01, '']]],
    [
      'Enter and exit',
      [
        ['thumpHz', 'Thump start', 40, 200, 1, 'Hz'],
        ['thumpEnd', 'Thump end', 20, 120, 1, 'Hz'],
        ['thumpTime', 'Thump length', 0.05, 0.8, 0.01, 's'],
        ['thumpLevel', 'Thump level', 0, 1.5, 0.01, ''],
        ['clickLevel', 'Click level', 0, 1, 0.01, ''],
        ['whooshLo', 'Whoosh low', 80, 1000, 10, 'Hz'],
        ['whooshHi', 'Whoosh high', 1000, 12000, 50, 'Hz'],
        ['whooshQ', 'Whoosh Q', 0.3, 6, 0.1, ''],
        ['whooshLevel', 'Enter whoosh level', 0, 1.5, 0.01, ''],
        ['exitWhooshLevel', 'Exit whoosh level', 0, 1.5, 0.01, ''],
        ['enterTail', 'Enter tail', 0, 1.5, 0.05, 's'],
        ['exitTail', 'Exit tail', 0, 1.5, 0.05, 's'],
        ['buzzLevel', 'Buzz level', 0, 0.6, 0.005, ''],
        ['buzzLo', 'Buzz filter low', 60, 600, 5, 'Hz'],
        ['buzzHi', 'Buzz filter high', 300, 5000, 50, 'Hz'],
      ],
    ],
    [
      'Cracks',
      [
        ['crackLevel', 'Level', 0, 2, 0.01, ''],
        ['crackPitch', 'Pitch ± (random)', 0, 0.15, 0.005, ''],
        ['crackShift', 'Pitch', -7, 12, 1, 'st'],
      ],
    ],
    [
      'Shatter',
      [
        ['shatterLevel', 'Level', 0, 2, 0.01, ''],
        ['shatterPitch', 'Pitch', -7, 12, 1, 'st'],
        ['shatterBody', 'Low body', 0, 1.5, 0.01, ''],
      ],
    ],
    [
      'Power button',
      [
        ['powerLevel', 'Level (1 = as enter/exit)', 0, 1.5, 0.01, ''],
        ['powerTail', 'Tail', 0, 1, 0.05, 's'],
      ],
    ],
    [
      'Static',
      [
        ['staticLevel', 'Level', 0, 1, 0.01, ''],
        ['humLevel', 'Hum', 0, 1.5, 0.01, ''],
        ['crackleLevel', 'Crackle', 0, 2, 0.01, ''],
        ['staticHold', 'Hold', 0, 4, 0.05, 's'],
        ['staticFade', 'Fade', 0.2, 6, 0.05, 's'],
      ],
    ],
  ];

  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const say = (s: string) => (status.textContent = s);

  // ── Sliders ──
  const box = document.querySelector<HTMLElement>('[data-sliders]')!;
  const inputs = new Map<Key, HTMLInputElement>();
  const fmt = (k: Key, v: number, unit: string) => (k === 'crackPitch' ? `${(v * 100).toFixed(1)} %` : `${+v.toFixed(3)}${unit ? ` ${unit}` : ''}`);
  for (const [title, sliders] of GROUPS) {
    const group = document.createElement('details');
    group.className = 'dev-sound__fold';
    group.open = title === 'Power button';
    const summary = document.createElement('summary');
    summary.className = 'mono dev-sound__heading';
    summary.textContent = title;
    group.append(summary);
    for (const [k, label, min, max, step, unit] of sliders) {
      const row = document.createElement('label');
      row.className = 'dev-sound__slider';
      const name = document.createElement('span');
      name.textContent = label;
      const input = document.createElement('input');
      Object.assign(input, { type: 'range', min: String(min), max: String(max), step: String(step), value: String(sound.params[k]) });
      const out = document.createElement('output');
      out.className = 'mono';
      out.textContent = fmt(k, sound.params[k], unit);
      input.addEventListener('input', () => {
        sound.params[k] = Number(input.value);
        out.textContent = fmt(k, sound.params[k], unit);
        if (k === 'master') sound.applyMaster();
      });
      inputs.set(k, input);
      row.append(name, input, out);
      group.append(row);
    }
    box.append(group);
  }

  const go = (fn: () => void) => async () => {
    sound.unlock();
    fn();
  };

  // ── Sounds ──
  const play = (name: string) => {
    if (name === 'enter') sound.enter(PLAY.dive);
    else if (name === 'exit') sound.exit(playMs(1));
    else if (name === 'shatter') sound.shatter();
    else if (name === 'static') sound.static(true);
    else if (name === 'power-off') sound.power(-1);
    else if (name === 'power-on') sound.power(1);
  };
  for (const b of document.querySelectorAll<HTMLElement>('[data-play]')) b.addEventListener('click', go(() => play(b.dataset.play!)));
  document.querySelector('[data-stop]')!.addEventListener('click', () => sound.stopAll());

  // ── Cracks ──
  const NAMES: Record<string, string> = { 'glass-1': '#1', 'glass-3': '#3' };
  const ALL = sound.CRACK_FILES;
  const useBoxes = [...document.querySelectorAll<HTMLInputElement>('[data-use]')];
  const picked = () => ALL.filter((f) => useBoxes.find((b) => b.dataset.use === f)?.checked);
  const stageBox = document.querySelector<HTMLElement>('[data-stages]')!;
  const stages = sound.CRACK_STAGES.map((_, i) => {
    const box = document.createElement('div');
    box.className = 'mono dev-sound__label dev-sound__stage';
    const sel = document.createElement('select');
    sel.className = 'mono dev-sound__select';
    sel.setAttribute('aria-label', `Stage ${i + 1}`);
    const cutLabel = document.createElement('label');
    cutLabel.className = 'dev-sound__field';
    const cut = document.createElement('input');
    cut.type = 'checkbox';
    cutLabel.append(cut, 'cut to fit');
    box.append(`Stage ${i + 1}`, sel, cutLabel);
    stageBox.append(box);
    return { sel, cut };
  });
  const stageSelects = stages.map((s) => s.sel);
  const setGameOrder = () => {
    stages.forEach((s, i) => (s.cut.checked = sound.CRACK_STAGES[i]!.cut));
    fillStages(sound.CRACK_STAGES.map((s) => s.file));
  };
  /** Each stage offers only the picked sounds; a stage whose sound was unpicked takes the first picked one. */
  const fillStages = (order: readonly string[] = stageSelects.map((s) => s.value)) => {
    const use = picked();
    stageSelects.forEach((sel, i) => {
      const want = order[i] ?? '';
      sel.replaceChildren(...use.map((f) => new Option(NAMES[f] ?? f, f)));
      sel.disabled = use.length === 0;
      if (use.length) sel.value = (use as readonly string[]).includes(want) ? want : use[0]!;
    });
  };
  setGameOrder();
  for (const b of useBoxes) b.addEventListener('change', () => fillStages());
  const paceSel = document.querySelector<HTMLSelectElement>('[data-pace]')!;
  const run = () => {
    if (!picked().length) return say('Pick at least one sound.');
    const pace = Number(paceSel.value);
    stages.forEach(({ sel, cut }, i) => {
      const file = sel.value as sound.FileName;
      setTimeout(() => sound.crack(i + 1, undefined, file, cut.checked), i * pace);
    });
    // the beat and the burst, as the game times them
    setTimeout(() => {
      sound.shatter();
      sound.static(true);
    }, 5 * pace + 300 + pace);
  };
  document.querySelector('[data-run]')!.addEventListener('click', go(run));
  document.querySelector('[data-now]')!.addEventListener('click', () => {
    for (const b of useBoxes) b.checked = sound.CRACK_STAGES.some((s) => s.file === b.dataset.use);
    setGameOrder();
    say('');
  });
  for (const b of document.querySelectorAll<HTMLElement>('[data-try]')) b.addEventListener('click', go(() => sound.crack(4, undefined, b.dataset.try as sound.FileName)));
  document.querySelector('[data-copy-order]')!.addEventListener('click', async () => {
    const name = (f: string) => NAMES[f] ?? f;
    const text =
      `Picked: ${picked().map(name).join(', ')}. ` +
      `Order: ${stages.map(({ sel, cut }, i) => `${i + 1} ${name(sel.value)}${cut.checked ? ' cut' : ''}`).join(', ')}`;
    try {
      await navigator.clipboard.writeText(text);
      say('Copied.');
    } catch {
      say(text);
    }
  });

  // ── Numbers ──
  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    Object.assign(sound.params, sound.defaults);
    for (const [k, input] of inputs) {
      input.value = String(sound.params[k]);
      input.dispatchEvent(new Event('input'));
    }
  });
  document.querySelector('[data-copy]')!.addEventListener('click', async () => {
    const json = JSON.stringify(sound.params, null, 2);
    try {
      await navigator.clipboard.writeText(json);
      say('Values copied.');
    } catch {
      say('Copy failed: values logged to the console.');
    }
    console.log(json);
  });
</script>

<style>
  .dev-sound {
    display: grid;
    gap: var(--space-6);
    max-width: 960px;
    margin: 0 auto;
    padding: calc(var(--nav-h, 64px) + var(--space-8)) var(--space-4) var(--space-12);
  }

  .dev-sound__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .dev-sound__row + .dev-sound__row {
    margin-top: var(--space-3);
  }

  .dev-sound__row--end {
    justify-content: flex-end;
    margin-top: var(--space-4);
  }

  .dev-sound__spacer {
    flex: 1;
  }

  .dev-sound__group + .dev-sound__group {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-green-900);
  }

  .dev-sound :global(.dev-sound__heading) {
    margin: 0 0 var(--space-3);
    text-align: left;
    font-size: var(--text-sm);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dev-sound__note,
  .dev-sound__status,
  .dev-sound :global(.dev-sound__label) {
    font-size: var(--text-sm);
  }

  .dev-sound__picks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column; /* ours down the left, the new ones down the right */
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dev-sound__pick {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .dev-sound__pick strong {
    font-weight: 700;
  }

  .dev-sound__note {
    margin: var(--space-6) 0 0;
    opacity: 0.75;
  }

  .dev-sound__stages {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .dev-sound :global(.dev-sound__stage) {
    display: grid;
    gap: var(--space-1);
  }

  .dev-sound__field {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dev-sound__field input {
    accent-color: var(--color-green-900);
  }

  .dev-sound :global(.dev-sound__select) {
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-green-900);
    border-radius: 0;
    background: transparent;
    color: inherit;
  }

  .dev-sound__sliders {
    display: grid;
    gap: var(--space-4);
  }

  .dev-sound :global(.dev-sound__fold) {
    display: grid;
    gap: var(--space-2);
  }

  .dev-sound :global(.dev-sound__fold > summary) {
    cursor: pointer;
    margin: 0;
  }

  .dev-sound :global(.dev-sound__slider) {
    display: grid;
    grid-template-columns: 12rem 1fr 6rem;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .dev-sound :global(.dev-sound__slider input) {
    width: 100%;
    accent-color: var(--color-green-900);
  }

  @media (max-width: 760px) {
    .dev-sound__stages {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .dev-sound__picks {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }

    .dev-sound__stages {
      grid-template-columns: repeat(2, 1fr);
    }

    .dev-sound :global(.dev-sound__slider) {
      grid-template-columns: 1fr 5rem;
    }

    .dev-sound :global(.dev-sound__slider input) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
