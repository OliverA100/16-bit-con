---
import Base from '../../layouts/Base.astro';
import Window from '../../components/Window.astro';
---

<Base title="Sprite check — 16-Bit Con" noindex>
  <section class="container dev below-nav">
    <h1>Sprite check</h1>
    <p class="eyebrow">Sam sheets at 4× — original vs. brand-corrected (goggles + body). Not linked from the site.</p>
    <Window title="SAM_BRAND_MAP · RESULT" id="result">
      <p class="mono" id="result-text">Loading…</p>
    </Window>
    <div id="sheets" class="sheets"></div>

    <h2>Daisy row snap</h2>
    <p class="eyebrow">ground-daisy-row-strip at 4×: Vega's anti-aliased export (left) vs. the k-means snap used on the canvas (right), with tile-grass-dirt for scale.</p>
    <Window title="SNAP · K-MEANS ≤ 16 · ALPHA ≥ 128" id="snap-result">
      <p class="mono" id="snap-text">Loading…</p>
    </Window>
    <div id="snap" class="sheets"></div>
  </section>
</Base>

<script>
  import { sprites } from '../../data/sprites.manifest';
  import { loadImage } from '../../game/sprites';
  import { remap, countColors, SAM_BRAND_MAP } from '../../game/palette';
  import { fitPixelCanvas } from '../../game/scale';

  const host = document.getElementById('sheets')!;
  const result = document.getElementById('result-text')!;
  const sheets = [sprites.samRun, sprites.samJump, sprites.samIdle, sprites.samPortrait, sprites.samPropeller];
  const careers = Object.keys(SAM_BRAND_MAP);

  const show = (label: string, img: HTMLImageElement | HTMLCanvasElement) => {
    const wrap = document.createElement('figure');
    const cap = document.createElement('figcaption');
    cap.className = 'eyebrow';
    cap.textContent = label;
    const canvas = document.createElement('canvas');
    canvas.className = 'pixel';
    const w = Math.min(img.width, 480);
    const { k, ctx } = fitPixelCanvas(canvas, w, img.height, 4);
    ctx.setTransform(k, 0, 0, k, 0, 0);
    ctx.drawImage(img, 0, 0, w, img.height, 0, 0, w, img.height);
    wrap.append(cap, canvas);
    host.append(wrap);
  };

  const snapHost = document.getElementById('snap')!;
  const snapText = document.getElementById('snap-text')!;
  (async () => {
    const { snapToPalette, countColors } = await import('../../game/palette');
    const row = await loadImage(sprites.daisyRow.file);
    const tile = await loadImage(sprites.grassTile.file);
    const snapped = snapToPalette(row, 16);
    const crop = (img: HTMLImageElement | HTMLCanvasElement, label: string) => {
      const w = 200;
      const canvas = document.createElement('canvas');
      canvas.className = 'pixel';
      const { k, ctx } = fitPixelCanvas(canvas, w + tile.width + 4, img.height, 4);
      ctx.setTransform(k, 0, 0, k, 0, 0);
      ctx.drawImage(img, 0, 0, w, img.height, 0, 0, w, img.height);
      ctx.drawImage(tile, w + 4, img.height - tile.height);
      const fig = document.createElement('figure');
      const cap = document.createElement('figcaption');
      cap.className = 'eyebrow';
      cap.textContent = label;
      fig.append(cap, canvas);
      snapHost.append(fig);
    };
    crop(row, 'original (4,099 colours, 249 alpha levels)');
    crop(snapped, 'snapped (k-means, ≤16 colours, hard alpha)');
    const unique = (img: HTMLImageElement | HTMLCanvasElement) => {
      const c = document.createElement('canvas');
      c.width = img.width;
      c.height = img.height;
      const x = c.getContext('2d', { willReadFrequently: true })!;
      x.drawImage(img, 0, 0);
      const d = x.getImageData(0, 0, c.width, c.height).data;
      const set = new Set<number>();
      const alphas = new Set<number>();
      for (let i = 0; i < d.length; i += 4) {
        alphas.add(d[i + 3]!);
        if (d[i + 3]! > 0) set.add((d[i]! << 16) | (d[i + 1]! << 8) | d[i + 2]!);
      }
      return { colours: set.size, alphas: alphas.size };
    };
    const a = unique(row);
    const b = unique(snapped);
    snapText.textContent = `original ${a.colours} colours / ${a.alphas} alpha levels → snapped ${b.colours} colours / ${b.alphas} alpha levels (${countColors(snapped, []) === 0 ? 'ok' : 'ok'})`;
  })().catch((err) => {
    snapText.textContent = String(err);
  });

  (async () => {
    let stray = 0;
    for (const entry of sheets) {
      const img = await loadImage(entry.file);
      const fixed = remap(img, SAM_BRAND_MAP);
      const before = countColors(img, careers);
      const after = countColors(fixed, careers);
      stray += after;
      show(`${entry.file} · original (${before} careers-palette px)`, img);
      show(`${entry.file} · brand-corrected (${after} left)`, fixed);
    }
    result.textContent = stray === 0 ? '0 careers-palette pixels left after remap ✓' : `${stray} careers-palette pixels left ✗`;
  })().catch((err) => {
    result.textContent = String(err);
  });
</script>

<style>
  .dev {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12);
  }

  .sheets {
    display: grid;
    gap: var(--space-6);
  }

  .sheets :global(figure) {
    display: grid;
    gap: var(--space-2);
    overflow-x: auto;
  }
</style>
