---
/**
 * /dev/monitor — the monitor on its own, for review: ?view=front34|side|closeup,
 * ?fill=0.6 to frame it larger than the rest size (22 % of the width, ≥ 220 px), ?live to drag it
 * around and let the rolling bar run, ?clean to hide the measurement table. The screen shows a still
 * of the game's title frame. ?poster=off|on renders a poster (public/monitor/, the screen off or on
 * with the game's screen frame) and leaves the PNG and its measurements on window.__poster.
 * Review page only (noindex); removed before handoff.
 */
import Base from '../../layouts/Base.astro';
---

<Base title="Monitor — 16-Bit Con (review)" description="Review page" noindex>
  <style is:inline>
    body > .nav-slot, .skip-link, .site-footer { display: none !important; }
  </style>
  <canvas class="dev-monitor" id="dev-monitor" aria-label="The 16-Bit Con monitor, rendered in three.js" role="img"></canvas>
  <pre class="dev-monitor__table" id="dev-monitor-table" aria-live="polite"></pre>
</Base>

<script>
  import { Color, NearestFilter, TextureLoader } from 'three';
  import { createMonitor, REST, restWidth, VIEWS } from '../../monitor';
  import { tuneAtRest } from '../../monitor/crt';
  import { readToken } from '../../game/palette';

  const params = new URLSearchParams(location.search);
  const view = VIEWS[params.get('view') ?? 'front34'] ?? REST;
  const fill = Number(params.get('fill')) || 0;
  const live = params.has('live');
  const poster = params.get('poster');
  const canvas = document.getElementById('dev-monitor') as HTMLCanvasElement;
  const table = document.getElementById('dev-monitor-table')!;
  if (params.has('clean') || poster) table.hidden = true;

  const m = createMonitor(canvas);
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  // Tuning knobs for the review sweep: ?exp ?env ?key ?rim ?albedo (mix toward Yellow 500) ?gr ?gi ?gry ?grx (glass)
  const knob = (k: string) => (params.has(k) ? Number(params.get(k)) : null);
  const set = <T,>(v: number | null, f: (n: number) => T) => v !== null && f(v);
  set(knob('exp'), (v) => (m.renderer.toneMappingExposure = v));
  set(knob('env'), (v) => (m.scene.environmentIntensity = v));
  set(knob('key'), (v) => (m.lights.key.intensity = v));
  set(knob('rim'), (v) => (m.lights.rim.intensity = v));
  set(knob('albedo'), (v) => m.parts.materials.plastic.color.copy(new Color().setStyle(readToken('--color-florets-yellow'))).lerp(new Color().setStyle(readToken('--color-yellow-500')), v));
  set(knob('gr'), (v) => (m.parts.materials.glass.roughness = v));
  set(knob('gi'), (v) => (m.parts.materials.glass.envMapIntensity = v));
  set(knob('gry'), (v) => (m.parts.materials.glass.envMapRotation.y = v));
  set(knob('grx'), (v) => (m.parts.materials.glass.envMapRotation.x = v));
  const texture = await new TextureLoader().loadAsync(params.get('frame') ?? (poster === 'on' ? '/dev/screen-frame.png' : '/dev/title-frame.png'));
  const img = texture.image as HTMLImageElement;
  m.setFrame(texture, img.width / img.height);
  if (params.get('min') === 'nearest') {
    // the comparison for the report: no mipmaps, nearest when minified too
    texture.minFilter = NearestFilter;
    texture.generateMipmaps = false;
    texture.needsUpdate = true;
  }

  let yaw = view.yaw;
  let pitch = view.pitch;
  const layout = () => {
    m.setSize(window.innerWidth, window.innerHeight);
    const slot = { cx: window.innerWidth / 2, cy: window.innerHeight / 2 };
    // The CRT is tuned at rest: scanlines every 3 device px, a ~4 px glow — then every other view
    // shows them as the zoom will, scaled with the screen.
    const rest = m.frame(REST, { ...slot, w: restWidth(window.innerWidth) });
    tuneAtRest(m.crt, rest.screenW * dpr, rest.screenH * dpr);
    // ?crt=scan:0.6,mask:0.3 … sets the tube's effect amounts (uScan, uMask, …) for a tuning sweep
    for (const kv of (params.get('crt') ?? '').split(',').filter(Boolean)) {
      const [k, v] = kv.split(':');
      const uni = (m.crt.uniforms as unknown as Record<string, { value: unknown }>)[`u${k![0]!.toUpperCase()}${k!.slice(1)}`];
      if (uni && typeof uni.value === 'number') uni.value = Number(v);
    }
    const shown = m.frame({ ...view, yaw, pitch }, { ...slot, w: fill ? fill * window.innerWidth : restWidth(window.innerWidth) });
    const g = m.measure();
    table.textContent = [
      `view ${params.get('view') ?? 'front34'}  yaw ${yaw.toFixed(1)}°  pitch ${pitch.toFixed(1)}°  fov 30°`,
      `rest silhouette ${(rest.box.x1 - rest.box.x0).toFixed(0)} px of ${window.innerWidth} (${(((rest.box.x1 - rest.box.x0) / window.innerWidth) * 100).toFixed(1)} %)`,
      `screen at rest ${rest.screenW.toFixed(0)} × ${rest.screenH.toFixed(0)} css px → ${m.crt.uniforms.uScanLines.value.toFixed(0)} scanlines`,
      `shown ${(shown.box.x1 - shown.box.x0).toFixed(0)} px`,
      ...Object.entries(g).map(([k, v]) => `${k.padEnd(22)} ${v.toFixed(4)}`),
    ].join('\n');
    (window as unknown as { __monitor: unknown }).__monitor = { m, rest, shown, measure: g };
  };
  layout();
  m.crt.uniforms.uTime.value = Number(params.get('time') ?? 4.6);
  if (poster) {
    // As the page shows it: off = the dark tube under the glass; on = the settled screen, its light on
    // the bevel (src/monitor/hero.ts), the rolling bar at the bottom edge.
    const u = m.crt.uniforms;
    const bevel = m.parts.materials.bevel;
    u.uOn.value = u.uOpen.value = poster === 'on' ? 1 : 0;
    u.uLine.value = 0;
    u.uTime.value = 5.95;
    bevel.emissive.copy(new Color().setStyle(readToken('--color-blue-300')).lerp(new Color().setStyle(readToken('--color-cloud-white')), 0.5));
    bevel.emissiveIntensity = poster === 'on' ? 0.35 : 0;
    const rest = m.frame(REST, { cx: window.innerWidth / 2, cy: window.innerHeight / 2, w: restWidth(window.innerWidth) });
    m.render();
    const corners = [
      [0, 0],
      [1, 0],
      [1, 1],
      [0, 1],
    ].map(([cu, cv]) => m.toCss(m.screenPoint(cu!, cv!)));
    (window as unknown as { __poster: unknown }).__poster = {
      png: canvas.toDataURL('image/png'),
      box: rest.box,
      corners,
      cssW: window.innerWidth,
      cssH: window.innerHeight,
      pr: m.renderer.getPixelRatio(),
      scanLines: m.crt.uniforms.uScanLines.value,
    };
  } else m.render();
  document.body.dataset.ready = '1';

  window.addEventListener('resize', () => {
    layout();
    m.render();
  });

  if (live) {
    let drag: { x: number; y: number; yaw: number; pitch: number } | null = null;
    canvas.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, y: e.clientY, yaw, pitch };
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drag) return;
      yaw = drag.yaw - (e.clientX - drag.x) * 0.3;
      pitch = Math.max(-10, Math.min(60, drag.pitch + (e.clientY - drag.y) * 0.2));
      layout();
    });
    canvas.addEventListener('pointerup', () => (drag = null));
    const tick = (now: number) => {
      m.crt.uniforms.uTime.value = now / 1000;
      m.render();
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .dev-monitor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    touch-action: none;
  }

  .dev-monitor__table {
    position: fixed;
    left: var(--space-4);
    bottom: var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    pointer-events: none;
  }
</style>
