---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import World from '../components/World.astro';
import ScheduleDrawer from '../components/ScheduleDrawer.astro';
import RegisterForm from '../components/RegisterForm.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base skip={{ href: '#register', label: 'Skip the game, to registration' }}>
  <World />

  <!--
    The landing: Sam breaks out of the monitor and lands here, on the Register window's title bar. The
    section follows the hero as on any page; the game scrolls down to it with him as he falls.
  -->
  <section class="section container landing" aria-labelledby="landing-title">
    <SectionHeader
      id="landing-title"
      title="Grab your pass"
      sub="Free to attend, but spots are limited. Pick a day or all three at the Javits Center, October 3–5, then come find us at Booth 630."
    />
    <div class="landing__window">
      <div class="landing__perch" data-landing>
        <canvas class="landing__sam pixel" width="60" height="60" aria-hidden="true" data-landing-sam></canvas>
        <Window size="compact" title="Sam" class="landing__bubble" data-landing-bubble>
          <!-- Typed out like his lines in the game once he lands (src/game/typing.ts: the whole line keeps its
               layout while it types); whole for screen readers, on the static page and without JS. -->
          <p class="mono landing__line">
            <span aria-hidden="true" data-landing-typed>Made it. Find me at Booth&nbsp;630.</span>
            <span class="sr-only">Made it. Find me at Booth&nbsp;630.</span>
          </p>
        </Window>
      </div>
      <RegisterForm />
    </div>
  </section>

  <!-- In the game, "Register now" moves the Register window in here, over the paused game, and back on close. -->
  <dialog class="register-dialog" aria-labelledby="register-title" data-register-dialog></dialog>

  <section class="section container" id="schedule" aria-labelledby="schedule-title">
    <SectionHeader id="schedule-title" title="Schedule" sub="Nine sessions. Three days. Zero save states." />
    <ScheduleDrawer />
  </section>
</Base>


<style>
  /* ── Sections ── */
  /* One rhythm between sections (--section-gap); the last keeps room under it so that, with the footer's
     own --space-12, the page ends on the same gap. Inside a section, its header (SectionHeader) stands
     --head-to-content above what it introduces. */
  .section {
    display: grid;
    gap: var(--head-to-content);
    justify-items: center;
    padding-top: var(--section-gap);
  }

  .section:last-of-type {
    padding-bottom: calc(var(--section-gap) - var(--space-12));
  }

  /* ── The landing: the Register window with Sam on its title bar (--sam-px: CSS px per art px, whole
        device px; set by the world, else the page's own k at 2×) and his bubble beside him. ── */
  /* Above the Register window: --space-24, which with the hero's own room under its tagline makes the
     page's airy gap. The same in every mode: Sam and his bubble stand in it once he has landed. */
  .landing {
    position: relative;
    z-index: 2;
    padding-top: var(--space-24);
    /* From the subheading to the window: room for Sam's bubble over Sam, at its tallest line (three
       lines of 21 px, its 33 px bar, 12 px padding above and below and its 1 px frame: 122 px) standing
       24 art px up, and 24 px clear of the subheading; never less than the headers' own gap. */
    gap: max(var(--head-to-content), calc(24 * var(--sam-px, 1.5px) + 122px + var(--space-6)));
  }

  /* No Sam on the window yet (the game's page before it is played, or left before he lands): the headers' own
     gap. The room opens as play starts and stays once he has landed (is-done); both happen with the window
     off screen, below the pinned opening, so nothing ever moves under him or the reader. */
  :global(:root.has-game:not(.is-playing):not(.is-done)) .landing {
    gap: var(--head-to-content);
  }

  /* Without JavaScript nothing draws Sam, so his perch (he and his line) is not shown, and the gap is the
     headers' own. */
  @media (scripting: none) {
    .landing {
      gap: var(--head-to-content);
    }

    .landing__perch {
      display: none;
    }
  }

  .landing__window {
    position: relative;
    width: min(100%, var(--window-max));
  }

  .landing__perch {
    position: absolute;
    bottom: 100%;
    left: var(--space-6);
    z-index: 1;
    width: calc(60 * var(--sam-px, 1.5px));
    height: 0;
  }

  /* his soles on the bar's top edge: the cell's last 5 rows are below his feet (FOOT_SINK) */
  .landing__sam {
    position: absolute;
    bottom: calc(-5 * var(--sam-px, 1.5px));
    left: 0;
    width: calc(60 * var(--sam-px, 1.5px));
    height: calc(60 * var(--sam-px, 1.5px));
    image-rendering: pixelated;
  }

  .landing__bubble {
    position: absolute;
    bottom: calc(24 * var(--sam-px, 1.5px));
    left: calc(60 * var(--sam-px, 1.5px) + var(--space-2));
    width: min(15rem, calc(100vw - 2 * var(--gutter) - 60 * var(--sam-px, 1.5px) - var(--space-8)));
  }

  .landing__line {
    font: var(--type-line);
  }

  /* With the game on the page, Sam is in it until he escapes and lands: the perch (his bubble too) waits
     for him. In flight his box stays here and the world carries him by a transform from it (translate
     and scale). The static page shows him there from the start. */
  :global(:root.has-game) .landing__perch:not(.is-landed) :is(.landing__sam, .landing__bubble) {
    visibility: hidden;
  }

  /* Sam's bubble comes in as his window does in the game (World.astro .world__sam): down 8 px into
     place as it fades in, on the 16-bit steps; its line types out from the same moment. */
  :global(:root.has-game) .landing__bubble {
    transition:
      opacity var(--dur-base) var(--steps-16bit),
      transform var(--dur-base) var(--steps-16bit);
  }

  :global(:root.has-game) .landing__perch:not(.is-landed) .landing__bubble {
    opacity: 0;
    transform: translateY(-8px);
  }

  /* Out on the page (src/page/journey.ts): another canvas carries him, so this one hides at once and the
     bubble goes as it came; back on the window, both return. */
  :global(:root.has-game) .landing__perch.is-away .landing__sam {
    visibility: hidden;
  }

  :global(:root.has-game) .landing__perch.is-away .landing__bubble {
    opacity: 0;
    transform: translateY(-8px);
  }

  :global(:root.has-game) .landing__perch .landing__sam.is-flying {
    transform-origin: 0 0;
    visibility: visible;
  }

  /* ── Register over the game: the Register window itself, moved in; the page behind holds still ── */
  /* A scroller from the nav's foot to the bottom of the large viewport (100lvh), the Window in it like the page's
     own content: it runs on under Safari's toolbar the way the game does, never cut at its edge, and scrolls up
     out of sight at the nav's foot — as if under the nav, which is the Window's width (Safari draws nothing fixed
     above its viewport, so it could not go under the clock). Centred there when it fits; the bottom padding lets
     its end scroll clear of the toolbar even when the toolbar is shown (the small viewport, 100svh). A click
     beside the Window (on the scroller) closes it, as before. */
  .register-dialog {
    inset: var(--nav-h) 0 auto;
    width: 100%;
    max-width: none;
    height: calc(100lvh - var(--nav-h));
    max-height: none;
    margin: 0;
    padding: var(--space-2) var(--gutter) calc(var(--space-4) + 100lvh - 100svh);
    overflow: auto;
    overscroll-behavior: contain;
    background: none;
    border: 0;
    color: var(--text);
  }

  .register-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  /* centred while it fits; once it does not, its top under the nav and the rest below (auto margins go to 0) */
  .register-dialog :global(#register) {
    flex: none;
    width: min(var(--window-max), 100%);
    margin: auto;
  }

  /* No backdrop: the game shows through untouched. It is still a modal (focus trapped, the page inert). */
  .register-dialog::backdrop {
    background: transparent;
  }

  /* Things that appear step: the window drops 12 px into place as it fades in (4 steps, 200 ms); it goes
     back up and out in 150 ms (3 steps). */
  @media (prefers-reduced-motion: no-preference) {
    .register-dialog[open] {
      animation: register-dialog-in var(--dur-base) var(--steps-16bit);
    }

    .register-dialog.is-closing {
      animation: register-dialog-out calc(3 * var(--beat)) var(--steps-3) forwards;
    }
  }

  @keyframes register-dialog-in {
    from {
      opacity: 0;
      translate: 0 -12px;
    }
  }

  @keyframes register-dialog-out {
    to {
      opacity: 0;
      translate: 0 -12px;
    }
  }

  /* The page holds still under the dialog and while the camera zooms out of the game. (Through the
     breakout's finale the game holds it with listeners instead: src/game/index.ts holdPage.) */
  :global(:root:is(.is-paused, .is-exiting)) {
    overflow: hidden;
  }
</style>
