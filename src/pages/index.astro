---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import World from '../components/World.astro';
import SectionMarker from '../components/SectionMarker.astro';
import SessionCard from '../components/SessionCard.astro';
import RegisterForm from '../components/RegisterForm.astro';
import { sessions } from '../data/sessions';
import { sprites } from '../data/sprites.manifest';
---

<Base>
  <World />

  <!-- Arrival: the world's pin releases into this section — Sam has reached Booth 630, so the booth and the registration come first. -->
  <section class="section container" id="booth" aria-labelledby="booth-title">
    <SectionMarker sprite="handMegaphone" />
    <h2 id="booth-title">Find us at Booth 630</h2>
    <p class="section__lede">Vega is at the con all weekend. Bring your high scores.</p>
    <div class="cta">
      <Window title="Booth 630" id="booth-window">
        <img class="cta__sign" src="/sprites/ui/vega-logo.svg" alt="Vega" width="138" height="45" />
        <p class="cta__copy">Stickers, demos, a very good mole. The after party starts at 6:00 PM and ends when the arcade does.</p>
        <p class="eyebrow">Javits Center · Hall 3B · Booth 630</p>
        <p class="mono cta__url"><a href="https://vega.io/16-bit-con">vega.io/16-bit-con</a></p>
      </Window>
      <RegisterForm />
      <Window title="Player 1 bonus" id="bonus" class="bonus" hidden>
        <p class="bonus__gg">12/12 coins. GG.</p>
        <p class="bonus__copy">Say <span class="mono">16BIT-GG</span> at Booth 630 for the Player 1 bonus.</p>
        <p class="eyebrow">Counted in this tab only. Nothing is sent or stored.</p>
      </Window>
    </div>
  </section>

  <section class="section container" id="schedule" aria-labelledby="schedule-title">
    <SectionMarker sprite="handClipboard" />
    <h2 id="schedule-title">Schedule</h2>
    <p class="section__lede">Three sessions. Zero save states.</p>
    <ol class="sessions">
      {
        sessions.map((session) => (
          <li>
            <SessionCard session={session} />
          </li>
        ))
      }
    </ol>
  </section>
</Base>


<style>
  /* ── Sections ── */
  .section {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
    padding-top: var(--space-24);
  }

  .section :global(.marker) {
    margin-bottom: calc(-1 * var(--space-4));
  }

  .section__lede {
    color: var(--text-muted);
    text-align: center;
  }

  .sessions {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .cta {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .cta__sign {
    width: calc(2 * 138px);
    height: auto;
    margin-bottom: var(--space-4);
  }

  .cta__copy {
    margin-bottom: var(--space-2);
  }

  .cta__url {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border);
    font-size: var(--text-sm);
  }

  .bonus__gg {
    margin-bottom: var(--space-2);
    font-family: var(--font-pixel);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  .bonus__copy {
    margin-bottom: var(--space-3);
  }
</style>
