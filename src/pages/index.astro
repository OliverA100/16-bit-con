---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import World from '../components/World.astro';
import SectionMarker from '../components/SectionMarker.astro';
import SessionCard from '../components/SessionCard.astro';
import RegisterForm from '../components/RegisterForm.astro';
import { sessions } from '../data/sessions';
import { sprites } from '../data/sprites.manifest';
---

<Base>
  <World />

  <!--
    The landing: Sam breaks out of the monitor and lands here, on the Register
    window's title bar. With the breakout this section rises under the pinned monitor through the
    breakout's last stretch (--rise, set by the world); without it, it simply follows the world.
  -->
  <section class="section container landing" aria-labelledby="landing-title">
    <h2 class="sr-only" id="landing-title">Register for 16-Bit Con</h2>
    <div class="landing__window">
      <div class="landing__perch" data-landing>
        <canvas class="landing__sam pixel" width="60" height="60" aria-hidden="true" data-landing-sam></canvas>
        <Window title="Agent Sam" class="landing__bubble" data-landing-bubble>
          <p class="mono landing__line">Made it. Find me at Booth 630.</p>
        </Window>
      </div>
      <RegisterForm />
    </div>
  </section>

  <section class="section container" id="booth" aria-labelledby="booth-title">
    <SectionMarker sprite="handMegaphone" />
    <h2 id="booth-title">Find us at Booth 630</h2>
    <p class="section__lede">Vega is at the con all weekend. Bring your high scores.</p>
    <div class="cta">
      <Window title="Booth 630" id="booth-window">
        <img class="cta__sign" src="/sprites/ui/vega-logo.svg" alt="Vega" width="138" height="45" />
        <p class="cta__copy">Stickers, demos, a very good mole. The after party starts at 6:00 PM and ends when the arcade does.</p>
        <p class="eyebrow">Javits Center · Hall 3B · Booth 630</p>
        <p class="mono cta__url"><a href="https://vega.io/16-bit-con">vega.io/16-bit-con</a></p>
      </Window>
      <Window title="Player 1 bonus" id="bonus" class="bonus" hidden>
        <p class="bonus__gg">12/12 coins. GG.</p>
        <p class="bonus__copy">Say <span class="mono">16BIT-GG</span> at Booth 630 for the Player 1 bonus.</p>
        <p class="eyebrow">Counted in this tab only. Nothing is sent or stored.</p>
      </Window>
    </div>
  </section>

  <section class="section container" id="schedule" aria-labelledby="schedule-title">
    <SectionMarker sprite="handClipboard" />
    <h2 id="schedule-title">Schedule</h2>
    <p class="section__lede">Three sessions. Zero save states.</p>
    <ol class="sessions">
      {
        sessions.map((session) => (
          <li>
            <SessionCard session={session} />
          </li>
        ))
      }
    </ol>
  </section>
</Base>


<style>
  /* ── Sections ── */
  .section {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
    padding-top: var(--space-24);
  }

  .section :global(.marker) {
    margin-bottom: calc(-1 * var(--space-4));
  }

  .section__lede {
    color: var(--text-muted);
    text-align: center;
  }

  .sessions {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  /* ── The landing: the Register window with Sam on its title bar (--sam-px: CSS px per art px, whole
        device px; set by the world, else the page's own k at 2×) and Agent Sam beside him. ── */
  .landing {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--rise, 0px));
    padding-top: calc(var(--space-12) + 64 * var(--sam-px, 1.5px));
  }

  .landing__window {
    position: relative;
    width: min(100%, 36rem);
  }

  .landing__perch {
    position: absolute;
    bottom: 100%;
    left: var(--space-6);
    z-index: 1;
    width: calc(60 * var(--sam-px, 1.5px));
    height: 0;
  }

  /* his soles on the bar's top edge: the cell's last 5 rows are below his feet (FOOT_SINK) */
  .landing__sam {
    position: absolute;
    bottom: calc(-5 * var(--sam-px, 1.5px));
    left: 0;
    width: calc(60 * var(--sam-px, 1.5px));
    height: calc(60 * var(--sam-px, 1.5px));
    image-rendering: pixelated;
  }

  .landing__bubble {
    position: absolute;
    bottom: calc(24 * var(--sam-px, 1.5px));
    left: calc(60 * var(--sam-px, 1.5px) + var(--space-2));
    width: min(15rem, calc(100vw - 2 * var(--gutter) - 60 * var(--sam-px, 1.5px) - var(--space-8)));
    box-shadow: var(--shadow-hard-sm);
  }

  .landing__line {
    font-size: var(--text-sm);
  }

  /* With the breakout, Sam is in the game until he lands: the perch waits for him. In flight his box
     stays here and the world carries him by a transform from it (translate and scale). */
  :global(:root.has-breakout) .landing__perch:not(.is-landed) :is(.landing__sam, .landing__bubble) {
    visibility: hidden;
  }

  :global(:root.has-breakout) .landing__perch .landing__sam.is-flying {
    transform-origin: 0 0;
    visibility: visible;
  }

  .cta {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .cta__sign {
    width: calc(2 * 138px);
    height: auto;
    margin-bottom: var(--space-4);
  }

  .cta__copy {
    margin-bottom: var(--space-2);
  }

  .cta__url {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border);
    font-size: var(--text-sm);
  }

  .bonus__gg {
    margin-bottom: var(--space-2);
    font-family: var(--font-pixel);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  .bonus__copy {
    margin-bottom: var(--space-3);
  }
</style>
