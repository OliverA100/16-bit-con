---
/**
 * SectionMarker — one of Vega's "mole hand popping out of the dirt" CMS illustrations,
 * shown in the DOM at CSS 1:1 (never on the canvas, never scaled fractionally).
 */
import { sprites } from '../data/sprites.manifest';

interface Props {
  sprite: 'handClipboard' | 'handMegaphone';
  class?: string;
}

const { sprite, class: className } = Astro.props;
const s = sprites[sprite];
---

<img
  class:list={['marker', 'pixel', className]}
  src={s.file}
  width={s.w}
  height={s.h}
  loading="lazy"
  decoding="async"
  alt=""
  aria-hidden="true"
/>

<style>
  .marker {
    width: auto;
    height: auto;
    max-width: 100%;
    margin-inline: auto;
  }
</style>
