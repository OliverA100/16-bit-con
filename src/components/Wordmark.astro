<style>
  /* --wm-w is the width with the daisy. Without it the letters keep the same height, so the mark is
     narrower by the daisy's share of the width (670.33 / 818.38 of the viewBox). */
  .wm {
    display: block;
    width: var(--wm-w);
    max-width: 100%;
    margin: 0;
    color: var(--wordmark);
    line-height: 0;
  }

  .wm:not(.wm--daisy) {
    width: calc(var(--wm-w) * 670.33 / 818.38);
  }

  .wm__art {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Letters as tall as the Geist 900 caps they replace (0.726 em of a 3–8 rem wordmark). */
  .wm--hero {
    --wm-w: clamp(16.5rem, 85vw, 44rem);
  }

  /* About 20 px tall, like vega.io's nav logo: 19 px, so it never pushes the nav's button at 320 px. */
  .wm--nav {
    --wm-w: 7.75rem;
  }

  .wm--og {
    --wm-w: 60rem;
  }

  /* On the ticket: about 20 px tall with the daisy */
  .wm--ticket {
    --wm-w: 129px;
  }
</style>
