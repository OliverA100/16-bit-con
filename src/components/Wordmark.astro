---
/**
 * Wordmark — "16-Bit Con" set in its own identity, not as a headline; Signifier stays for
 * section headings. Geist 900, uppercase, tight tracking, with a plain typed hyphen. Chosen
 * 2026-11-08 over a 4 px-grid block wordmark; the daisy-icon hyphen was replaced by "-" on
 * 2026-11-09.
 */
interface Props {
  size?: 'hero' | 'nav' | 'og';
  as?: 'h1' | 'span' | 'div';
  id?: string;
  class?: string;
}
const { size = 'hero', as: Tag = 'span', id, class: className } = Astro.props;
---

<Tag class:list={['wm', `wm--${size}`, className]} id={id}>16-Bit Con</Tag>

<style>
  .wm {
    display: inline-block;
    margin: 0;
    color: var(--text);
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(3rem, 10.5vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wm--nav {
    font-size: 1.125rem;
    letter-spacing: -0.03em;
  }

  .wm--og {
    font-size: 10rem;
  }
</style>
