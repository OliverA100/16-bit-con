---
/**
 * Wordmark — "16-Bit Con", a custom wordmark drawn in the construction of Vega's own wordmark: the
 * same slant, stem and bar weights, corner logic and daisy. One colour, inline, so it inherits
 * color: var(--wordmark) through currentColor and needs no image request. The paths are copied
 * as they are from the drawn files; the viewBoxes are their tight crops, so the art sizes by
 * width with its height following. The SVG is decorative: the name is the visually hidden text
 * beside it, so an h1 made of it still has real text.
 */
interface Props {
  size?: 'hero' | 'nav' | 'og' | 'ticket';
  as?: 'h1' | 'span' | 'div';
  id?: string;
  class?: string;
  /** Vega's daisy after "CON" (the default), or the letters alone. */
  daisy?: boolean;
}
const { size = 'hero', as: Tag = 'span', id, class: className, daisy = true } = Astro.props;
