---
/**
 * Wordmark — "16-Bit Con", a custom wordmark drawn in the construction of Vega's own wordmark: the
 * same slant, stem and bar weights, corner logic and daisy. One colour, inline, so it inherits
 * color: var(--wordmark) through currentColor and needs no image request. The paths are copied
 * as they are from the drawn files; the viewBoxes are their tight crops, so the art sizes by
 * width with its height following. The SVG is decorative: the name is the visually hidden text
 * beside it, so an h1 made of it still has real text.
 */
interface Props {
  size?: 'hero' | 'nav' | 'ticket' | 'flyer';
  /** `flyer`: Yellow 600 letters in a Green 900 outline, as printed on the flyer (FlyerDialog.astro). */
  tone?: 'ink' | 'flyer';
  as?: 'h1' | 'span' | 'div';
  id?: string;
  class?: string;
  /** Vega's daisy after "CON" (the default), or the letters alone. */
  daisy?: boolean;
}
import { WORDMARK_DAISY, WORDMARK_DAISY_AT, WORDMARK_LETTERS } from '../data/wordmark';
const { size = 'hero', tone = 'ink', as: Tag = 'span', id, class: className, daisy = true } = Astro.props;
---

<Tag class:list={['wm', `wm--${size}`, { 'wm--daisy': daisy, 'wm--tone-flyer': tone === 'flyer' }, className]} id={id}>
  {
    daisy ? (
      <svg class="wm__art" xmlns="http://www.w3.org/2000/svg" viewBox="18.59 -10.69 818.38 126.82" fill="currentColor" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" d={WORDMARK_LETTERS}/>
        <path fill-rule="evenodd" transform={`translate(${WORDMARK_DAISY_AT.x} ${WORDMARK_DAISY_AT.y})`} d={WORDMARK_DAISY}/>
      </svg>
    ) : (
      <svg class="wm__art" xmlns="http://www.w3.org/2000/svg" viewBox="18.59 0.00 670.33 108.30" fill="currentColor" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" d={WORDMARK_LETTERS}/>
      </svg>
    )
  }
  <span class="sr-only">16-Bit Con</span>
</Tag>

<style>
  /* --wm-w is the width with the daisy. Without it the letters keep the same height, so the mark is
     narrower by the daisy's share of the width (670.33 / 818.38 of the viewBox). */
  .wm {
    display: block;
    width: var(--wm-w);
    max-width: 100%;
    margin: 0;
    color: var(--wordmark);
    line-height: 0;
  }

  .wm:not(.wm--daisy) {
    width: calc(var(--wm-w) * 670.33 / 818.38);
  }

  .wm__art {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Letters as tall as the Geist 900 caps they replace (0.726 em of a 3–8 rem wordmark). */
  .wm--hero {
    --wm-w: clamp(16.5rem, 85vw, 44rem);
  }

  /* About 20 px tall, like vega.io's nav logo: 19 px, so it never pushes the nav's button at 320 px. */
  .wm--nav {
    --wm-w: 7.75rem;
  }

  /* On the ticket: about 20 px tall with the daisy */
  .wm--ticket {
    --wm-w: 129px;
  }

  /* On the flyer: across its inner column */
  .wm--flyer {
    --wm-w: 100%;
  }

  /* Printed on the flyer: Yellow 600 in a 2 px Green 900 outline (drawn under the fill, so it shows outside
     only), round at the joins like a print's trap. */
  .wm--tone-flyer {
    color: var(--color-yellow-600);
  }

  .wm--tone-flyer .wm__art {
    overflow: visible;
  }

  .wm--tone-flyer .wm__art path {
    stroke: var(--color-green-900);
    stroke-width: 4px;
    stroke-linejoin: round;
    paint-order: stroke fill;
    vector-effect: non-scaling-stroke;
  }
</style>
