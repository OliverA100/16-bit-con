---
/**
 * ScheduleDrawer — the schedule as a drawer of Vega's tabbed folders, one day at a time. Index tabs
 * across the top pick the day (a tablist); the day's three folders stand in the drawer, every tab
 * showing its time and title. One folder is always open: it lifts out of the drawer into room
 * reserved above the folders, and plays its own pixel scene (src/schedule). Behaviour:
 * src/schedule/drawer.ts.
 *
 * The folder is Vega's folder frame (public/sprites/ui/frames/folder.svg) drawn in CSS and two
 * fixed slant pieces, so the tab's angle never changes with its label.
 */
import Window from './Window.astro';
import { days } from '../data/sessions';

const OPEN = 'opening-keynote'; // open by default: the brief's sessions read at once

type Pos = 'left' | 'middle' | 'right';
const positions: Pos[] = ['left', 'middle', 'right'];

const panels = days.map(({ day, sessions }) => {
  const id = day.toLowerCase().replace(' ', '-');
  const openIndex = sessions.findIndex((s) => s.id === OPEN);
  return {
    id,
    label: day,
    long: day.replace('Oct', 'October'),
    selected: openIndex >= 0,
    openIndex,
    folders: sessions.map((s, i) => ({ ...s, i, pos: positions[i % 3]! })),
  };
});

const plate = 'Files · Oct 3–5';
---

<div class="drawer" data-day="oct-3" data-open={OPEN} data-drawer>
  <div class="drawer__days" role="tablist" aria-label="Days" data-days>
    {
      panels.map((p) => (
        <button
          type="button"
          role="tab"
          class="tab daytab"
          id={`daytab-${p.id}`}
          aria-selected={p.selected ? 'true' : 'false'}
          aria-controls={`panel-${p.id}`}
          tabindex={p.selected ? 0 : -1}
          data-daytab={p.id}
        >
          <span class="tab__shape" aria-hidden="true"></span>
          <span class="tab__label mono">{p.label}</span>
        </button>
      ))
    }
  </div>

  <!-- The back card the day tabs stand on: the room for an open folder, then the day's folders. -->
  <div class="drawer__body">
    <div class="drawer__reserve"></div>
    <div class="drawer__files">
      {
        panels.map((p) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${p.id}`}
            aria-labelledby={`daytab-${p.id}`}
            data-panel={p.id}
            data-state={p.selected ? 'in' : 'out'}
            style={`--open: ${p.selected ? p.openIndex : 0};`}
            aria-hidden={p.selected ? undefined : 'true'}
          >
            <h3 class="sr-only">{p.long}</h3>
            <ol class="panel__folders">
              {p.folders.map((f) => {
                const open = f.id === OPEN;
                return (
                  <li class:list={['card', { 'is-open': open }]} style={`--i: ${f.i};`} data-folder={f.id} data-scene={f.scene} data-index={f.i}>
                    <button
                      type="button"
                      class="tab tab--folder"
                      id={`tab-${f.id}`}
                      data-pos={f.pos}
                      aria-expanded={open ? 'true' : 'false'}
                      aria-controls={`folder-${f.id}`}
                      aria-label={`${f.time} · ${f.tab}, ${f.title}`}
                      tabindex={p.selected ? undefined : -1}
                      data-tab
                    >
                      <span class="tab__shape" aria-hidden="true"></span>
                      <!-- The name is the visible label, then the full title (label in name, WCAG 2.5.3). The label is
                           drawn from data-label, so find-in-page lands on the folder's own text and opens it. -->
                      <span class="tab__label mono" data-label={`${f.time} · ${f.tab}`} />
                    </button>
                    <div class="card__body">
                      <!-- The folder's scene, under its text and below the strip a closed folder shows. -->
                      <div class="folder__scene">
                        <canvas class="folder__canvas pixel" width="0" height="0" aria-hidden="true" data-canvas />
                      </div>
                      <div
                        class="folder"
                        id={`folder-${f.id}`}
                        role="region"
                        aria-labelledby={`title-${f.id}`}
                        hidden={open ? undefined : 'until-found'}
                        data-region
                      >
                        <div class="folder__text">
                          <p class="folder__meta mono">
                            {f.time} · <span class="folder__place">{f.place}</span>
                          </p>
                          <h4 class="folder__title" id={`title-${f.id}`} tabindex="-1">
                            {f.title}
                          </h4>
                          <p class="folder__blurb">{f.blurb}</p>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
    </div>
  </div>

  <div class="drawer__front" aria-hidden="true">
    <p class="drawer__plate mono">{plate}</p>
    <span class="drawer__pull"></span>
  </div>
</div>

<!-- Without JavaScript nothing can open a folder or change the day, so the drawer gives way (the style below)
     to every session laid out, a window a day. -->
<noscript>
  <div class="plain">
    {
      panels.map((p) => (
        <Window as="section" title={p.long}>
          <ol class="plain__sessions">
            {p.folders.map((f) => (
              <li>
                <p class="folder__meta mono">
                  {f.time} · {f.place}
                </p>
                <h3 class="folder__title">{f.title}</h3>
                <p class="folder__blurb">{f.blurb}</p>
              </li>
            ))}
          </ol>
        </Window>
      ))
    }
  </div>
</noscript>

<script>
  import { bootDrawer } from '../schedule/drawer';

  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  if (drawer) bootDrawer(drawer);
</script>

<style>
  /* Without JavaScript: the sessions as plain windows instead of the drawer. */
  .plain {
    display: grid;
    gap: var(--space-6);
    width: min(100%, var(--window-max));
    text-align: left;
  }

  .plain__sessions {
    display: grid;
    gap: var(--rhythm-block);
    padding: 0;
    list-style: none;
  }

  .plain .folder__title {
    text-align: left;
  }

  /* ── Geometry. Top to bottom: the day tabs, the back card (the room an open folder lifts into, then
        the day's three folders, each --step below the one before), the drawer front. The open folder
        and the folders behind it lift by --rise, so its whole body shows above the folder in front,
        whose tab and edge cut it like the ground. Nothing here changes size. ── */
  .drawer {
    --tab-h: 36px; /* a tab as drawn; its button reaches one line further down (it covers its body's top line) */
    --step: calc(var(--tab-h) + var(--space-3)); /* a tab and the sliver of body under it */
    --view: 300px; /* an open folder's visible body: from its top line to the next folder's */
    --rise: calc(var(--view) - var(--step));
    /* A folder's move in nine steps of 50 ms, eased out along cubic-bezier(0.22, 1, 0.36, 1): big steps
       first, smaller as it settles. Each step lands on a whole pixel of --rise (252 px here, 352 px on
       phones), so the 1 px lines stay crisp while a step is held. Recompute if --view or --step change. */
    --ease-folder: linear(0 0%, 0 11.111%, 0.436508 11.111%, 0.436508 22.222%, 0.718254 22.222%, 0.718254 33.333%, 0.865079 33.333%, 0.865079 44.444%, 0.940476 44.444%, 0.940476 55.556%, 0.97619 55.556%, 0.97619 66.667%, 0.992063 66.667%, 0.992063 77.778%, 0.996032 77.778%, 0.996032 88.889%, 1 88.889%, 1 100%, 1 100%);
    --body-h: calc(var(--view) + var(--step));
    --gap: var(--space-3); /* the back card's sliver above an open folder */
    --files-h: calc(3 * var(--step) + var(--tab-h));
    --inset: var(--space-8);
    --front-h: 180px;
    /* The scene's box, standing on the ground, up to one step below the body's top line: a closed folder
       shows that top step of its body, so it stays clear and no scene ever shows in a closed folder. */
    --scene-h: calc(var(--view) - var(--step));
    --dur-fade: 250ms; /* the open folder's text, in as it rises, out as it sinks */

    position: relative;
    /* over the page's beanstalk (z 1, src/page/stalk.ts): its leaves may reach behind the drawer */
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(100%, 64rem);
  }

  /* ── Day tabs: index tabs on the back card's top line; the selected one filled, opening into it ── */
  .drawer__days {
    position: relative;
    z-index: 2;
    display: flex;
    gap: var(--space-1);
    height: var(--tab-h);
    margin-inline: var(--inset);
  }

  .drawer__body {
    position: relative;
    z-index: 1;
    margin-inline: var(--inset);
    background: var(--surface-card);
    border: var(--border);
    border-bottom: 0;
    /* Cut at the front's top edge: the day's folders reach on under the front. Everything there is behind
       the opaque front, and clip (unlike a clip-path) also keeps it out of the page's scrollable area, so
       the page ends where the drawer does. */
    overflow-x: visible;
    overflow-y: clip;
  }

  /* The back card's side lines, drawn again above everything in it: a moving folder is painted as its own
     layer, and a browser may round that layer out by a pixel (Safari does), covering the line it sits
     against. Above the folders, the sides are never covered, at rest or in motion. */
  .drawer__body::after {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--line-w)) 0;
    z-index: 5;
    border-inline: var(--border);
    pointer-events: none;
  }

  /* the room the open folder lifts into */
  .drawer__reserve {
    height: calc(var(--rise) + var(--gap));
  }

  .drawer__files {
    position: relative;
    height: var(--files-h);
  }

  /* ── A day: its three folders, all days in the same place. The selected day stands in front; the others
        wait faded out with their first folder up — the one a day tab opens (aria-hidden, their tabs out of
        the tab order, not hit by the pointer). A day change is a crossfade on the 16-bit steps and nothing
        else: no folder moves, no slide (src/schedule/drawer.ts). Their folders' text stays findable:
        hidden="until-found". ── */
  .panel {
    position: absolute;
    inset: 0 0 auto; /* inside the back card's side lines, which are the folders' sides too */
    height: var(--files-h);
    transition: opacity var(--dur-base) var(--steps-16bit);
  }

  .panel[data-state='in'] {
    z-index: 2;
  }

  .panel[data-state='out'] {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .tab--folder .tab__label::before {
    content: attr(data-label);
  }

  .panel__folders {
    padding: 0;
    list-style: none;
  }

  .card {
    position: absolute;
    top: calc(var(--i) * var(--step));
    left: 0;
    right: 0;
    z-index: calc(var(--i) + 1);
    height: calc(var(--tab-h) + var(--body-h));
    translate: 0 calc(-1 * var(--rise) * clamp(0, var(--open) - var(--i) + 1, 1));
    /* the hover peek on its own channel: 1 px per 50 ms step, so it stays on whole pixels both ways */
    transform: translateY(calc(-1 * var(--peek, 0px)));
    transition:
      translate var(--dur-folder) var(--ease-folder),
      transform var(--dur-base) var(--steps-16bit);
  }

  /* Hover on a closed folder's tab: the folder peeks out of the drawer, a first bit of the lift that
     opening it makes, on the same 50 ms beat (4 px in four 1 px steps). Its tab's hit area reaches back
     down over the gap it leaves. Pointers that hover only; still with reduced motion. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    /* pressed, it drops back, as a button does */
    .card:not(.is-open):has(> .tab--folder:hover:not(:active)) {
      --peek: var(--folder-peek);
    }

    .card:not(.is-open) > .tab--folder:hover::after {
      inset: 0 0 calc(-8px - var(--folder-peek));
    }
  }

  .card__body {
    position: absolute;
    top: var(--tab-h);
    left: 0;
    right: 0;
    height: var(--body-h);
    background: var(--surface-card);
    /* Top and bottom lines only: the back card's side lines are every folder's sides. Two boxes drawing a
       line in the same place would part by a device pixel whenever a moving folder sits at a sub-pixel
       position; one line, drawn once by the box that never moves, cannot. */
    border-block: var(--border);
  }


  /* ── Tabs: one trapezoid per tab, Vega's folder tab, its outline drawn as one shape: an ink trapezoid
        and a Cloud White one inset by one line inside it (both clip-paths), so the slants and the top
        line meet exactly at any pixel density. The inner slant sits one line in across the slant:
        --slant-in at its top, --slant-foot at its foot (for a --slant over the tab's height). A folder
        tab reaches one line below its top, over its body's top line, so it opens into the body. ── */
  .tab {
    --slant: 22px;
    --slant-in: 22.57px; /* 22 − 22 × 1/37 + 1.16: the inner slant's top, one line in */
    --slant-foot: 1.16px; /* 1 × √(22² + 37²) / 37: one line, measured across the slant */
    --tab-room: var(--space-6); /* room either side of a folder tab's label: long tabs, as in the mock */
    --day-room: var(--space-6); /* the same for the day tabs, less where three must fit across a phone */

    position: absolute;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    height: calc(var(--tab-h) + var(--line-w));
    margin: 0;
    padding: var(--line-w) calc(var(--slant) + var(--tab-room)) 0;
    background: none;
    border: 0;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* 44 px to touch: the hit area reaches into the tab's own sliver */
  .tab::after {
    content: '';
    position: absolute;
    inset: 0 0 -8px;
  }

  .tab[data-pos='left'] {
    left: 0;
  }

  .tab[data-pos='middle'] {
    left: 50%;
    translate: -50% 0;
  }

  .tab[data-pos='right'] {
    right: 0;
  }

  /* The shape reaches one pixel below the tab: the outline still ends at the tab's foot, and the white
     inside carries on over the body's top line, so no sliver of that line shows under the tab whichever
     way a browser rounds the two. */
  .tab__shape {
    position: absolute;
    inset: 0 0 -1px;
    background: var(--outline);
    clip-path: polygon(0 calc(100% - 1px), var(--slant) 0, calc(100% - var(--slant)) 0, 100% calc(100% - 1px));
  }

  /* Under a folder tab, a plain Cloud White strip between its feet over its body's top line, a line
     either side of it: however a browser rounds the line and the tab's foot (at a zoom such as 110 % or
     220 % a line straddles two device pixels), no sliver of the line shows under an open tab. Plain fill,
     no outline in it, so no antialiased edge of ink either. */
  .tab--folder::before {
    content: '';
    position: absolute;
    inset: auto var(--slant-foot) calc(-1 * var(--line-w));
    height: calc(3 * var(--line-w));
    background: var(--surface-card);
  }

  .tab__shape::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--surface-card);
    clip-path: polygon(
      var(--slant-foot) 100%,
      var(--slant-in) var(--line-w),
      calc(100% - var(--slant-in)) var(--line-w),
      calc(100% - var(--slant-foot)) 100%
    );
  }

  .tab__label {
    position: relative;
    font: var(--type-ui);
    white-space: nowrap;
  }

  /* Day tabs: side by side on the back card's top line; the selected one filled, opening into the card. */
  .daytab {
    position: relative;
    height: var(--tab-h);
    padding-inline: calc(var(--slant) + var(--day-room));
  }

  .daytab[aria-selected='true'] {
    height: calc(var(--tab-h) + var(--line-w));
  }

  /* a day tab not selected stands on the back card's line, not opening into it: its shape ends at its foot */
  .daytab[aria-selected='false'] .tab__shape {
    inset: 0;
    clip-path: polygon(0 100%, var(--slant) 0, calc(100% - var(--slant)) 0, 100% 100%);
  }

  .daytab[aria-selected='true'] .tab__shape::after {
    background: var(--outline);
  }

  /* An unselected day tab lifts onto a hard Green 900 shadow with the weight of a button's (3 px of ink: a
     drop-shadow, so it follows the tab's slants; the tab is a clip-path shape). Under its foot the shadow
     joins the card's 1 px line, so it drops 2 px; on the right slant (22 across, 37 down) an offset (x, y)
     shows (37x − 22y) / 43 thick, so x = 4 gives ~2.4 px beside the slant's 1 px line. The selected tab stays
     put, as a selected button does. Its hit area reaches back over the gap it leaves. */
  .daytab {
    --tab-lift-x: 4px;
    --tab-lift-y: 2px;

    transition:
      translate var(--dur-lift) var(--ease-lift),
      filter var(--dur-lift) var(--ease-lift);
  }

  @media (hover: hover) {
    .daytab[aria-selected='false']:hover {
      translate: calc(-1 * var(--tab-lift-x)) calc(-1 * var(--tab-lift-y));
      filter: drop-shadow(var(--tab-lift-x) var(--tab-lift-y) 0 var(--outline));
    }

    .daytab[aria-selected='false']:hover::after {
      inset: 0 calc(-1 * var(--tab-lift-x)) calc(-8px - var(--tab-lift-y)) 0;
    }
  }

  .daytab[aria-selected='false']:active {
    translate: 0 0;
    filter: none;
  }

  .daytab[aria-selected='true'] .tab__label {
    color: var(--surface-card);
  }

  /* ── An open folder: its text top-left, its scene under it. The folder box is exactly the visible
        body: it ends on the next folder's top line, which is the scene's ground. ── */
  .folder {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: calc(var(--view) - var(--line-w));
    overflow: hidden;
  }

  /* hidden="until-found": the text stays in the page for find-in-page, which opens the folder
     (beforematch). The page-wide [hidden] rule would take it out of the page altogether. */
  .folder[hidden='until-found'] {
    display: block !important;
    content-visibility: hidden;
  }

  /* A folder's text shows while it is open: it fades in as the folder rises and out as it sinks, so it
     never appears or disappears in the strip a closed folder shows (it is hidden once faded out). */
  .folder__text {
    position: relative;
    z-index: 1;
    opacity: 0;
    transition: opacity var(--dur-fade) var(--steps-fade);
    display: grid;
    gap: var(--space-2);
    max-width: min(38rem, 64%);
    padding: var(--space-6) 0 0 var(--space-6);
  }

  .card.is-open .folder__text {
    opacity: 1;
  }

  .folder__meta {
    font: var(--type-ui);
  }

  .folder__title {
    font: var(--type-session);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .folder__title:focus {
    outline: none;
  }

  .folder__blurb {
    max-width: 30rem;
  }

  /* The scene's box ends on the ground: the next folder's top line (--view below this body's top line).
     It starts one step below the body's top line, the strip a closed folder shows, so a closed folder
     shows no scene; it keeps the frame it last showed underneath, ready for when it opens again. */
  .folder__scene {
    position: absolute;
    top: calc(var(--view) - var(--line-w) - var(--scene-h));
    left: 0;
    right: 0;
    height: var(--scene-h);
    overflow: hidden;
  }

  /* The canvas is sized by src/schedule/runner.ts in whole art pixels and moved down by a transform so
     its bottom meets the ground (its box never moves, so sizing it is never a layout shift). It fades in
     with its first frame. */
  .folder__canvas {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .folder__canvas[data-drawn] {
    opacity: 1;
  }

  .folder__canvas[data-drawn='fade'] {
    transition: opacity var(--dur-base) var(--steps-16bit);
  }

  /* ── The drawer front ── */
  /* The label in the upper part of the front and the pull a clear step below it, with more room under
     the pull than over the label, as on a real drawer (and the mock). */
  .drawer__front {
    position: relative;
    z-index: 3;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-8);
    padding-bottom: var(--space-6);
    height: var(--front-h);
    background: var(--surface-card);
    border: var(--border);
    box-shadow: var(--shadow-hard);
  }

  /* The drawer's label: a Daisy White nameplate screwed to the front, its frame, type and screws in the
     ink. Quiet under the scenes; no hard shadow and no lift, so it never reads as a button. */
  .drawer__plate {
    position: relative;
    padding: var(--space-3) calc(var(--space-12) + var(--space-2));
    background: var(--surface);
    border: var(--border);
    color: var(--text);
    font: var(--type-ui);
    white-space: nowrap;
  }

  /* The screws and the pull drawn as the window's title-bar squares are: a one-line outline whose corner
     pixels are left out (four lines, each stopping a line short of the corners), so the corners read as
     pixel-art notches at any size. */
  .drawer__plate::before,
  .drawer__plate::after,
  .drawer__pull {
    --edge: linear-gradient(var(--outline), var(--outline));
    background:
      var(--edge) left var(--line-w) top 0 / calc(100% - 2 * var(--line-w)) var(--line-w) no-repeat,
      var(--edge) left var(--line-w) bottom 0 / calc(100% - 2 * var(--line-w)) var(--line-w) no-repeat,
      var(--edge) left 0 top var(--line-w) / var(--line-w) calc(100% - 2 * var(--line-w)) no-repeat,
      var(--edge) right 0 top var(--line-w) / var(--line-w) calc(100% - 2 * var(--line-w)) no-repeat;
  }

  /* a screw at each end */
  .drawer__plate::before,
  .drawer__plate::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    height: 8px;
    margin: auto 0;
  }

  .drawer__plate::before {
    left: var(--space-3);
  }

  .drawer__plate::after {
    right: var(--space-3);
  }

  .drawer__pull {
    width: 144px;
    height: 14px;
  }

  /* ── Narrow: the same drawer, the open folder's text on top and its scene in a band below ── */
  /* The drawer's own break: under 860 px (53.75rem) the scene no longer fits beside the text. */
  @media (max-width: 53.6875rem) {
    .tab {
      --day-room: var(--space-3);
    }

    .drawer {
      --view: 400px;
      --ease-folder: linear(0 0%, 0 11.111%, 0.4375 11.111%, 0.4375 22.222%, 0.71875 22.222%, 0.71875 33.333%, 0.866477 33.333%, 0.866477 44.444%, 0.940341 44.444%, 0.940341 55.556%, 0.974432 55.556%, 0.974432 66.667%, 0.991477 66.667%, 0.991477 77.778%, 0.997159 77.778%, 0.997159 88.889%, 1 88.889%, 1 100%, 1 100%);
      --inset: var(--space-3);
      --front-h: 132px;
    }

    .folder__text {
      max-width: none;
      padding: var(--space-6) var(--space-4) 0;
    }

    .folder__title {
      font: var(--type-session-compact);
    }

    /* the label thinner on the phone's shorter front, as wide as on wide screens (the pull keeps its
       proportion to it) */
    .drawer__plate {
      padding-block: var(--space-2);
    }

    /* on phones, label and pull close together in the middle of the front */
    .drawer__front {
      gap: var(--space-4);
      padding-bottom: 0;
    }
