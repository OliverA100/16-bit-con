---
import Window from './Window.astro';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
---

<div class="nav-slot">
  <Window as="nav" bare title="16-BIT CON · OCT 3–5, 2026" id="site-nav" class="nav" aria-label="Primary">
    <a class="nav__brand" href="/">
      <img src="/favicon.svg" alt="" width="20" height="18" />
      <Wordmark size="nav" />
    </a>
    <!-- In the game it opens the form in a dialog over it (src/game/index.ts); otherwise it scrolls to it. -->
    <Button href="#register" data-register-link>Register now</Button>
  </Window>
</div>

<script>
  // "Register now" centres the Register window on screen (smoothly, or at once with reduced motion: the
  // page's own scroll-behavior) and moves focus there. In the game it opens the form in a dialog over it
  // instead (src/game/index.ts).
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-register-link]')) {
    link.addEventListener('click', (e) => {
      const root = document.documentElement;
      if (root.classList.contains('is-playing')) return;
      if (root.classList.contains('is-exiting')) {
        e.preventDefault();
        return;
      }
      const target = document.getElementById('register');
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ block: 'center' });
      target.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .nav-slot {
    position: fixed;
    top: var(--space-2);
    left: 50%;
    z-index: 20;
    width: min(100% - 2 * var(--gutter), var(--container));
    translate: -50% 0;
  }

  .nav :global(.window__body) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    line-height: 1;
    text-decoration: none;
  }

  .nav :global(.btn) {
    margin-left: auto;
  }
</style>
