---
import Window from './Window.astro';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
---

<div class="nav-slot">
  <Window as="nav" bare title="16-Bit Con · Oct 3–5, 2026" id="site-nav" class="nav" aria-label="Primary">
    <a class="nav__brand" href="/" aria-label="16-Bit Con home">
      <Wordmark size="nav" daisy={false} />
    </a>
    <!-- The home page's form from any page. On the home page it scrolls to it (the script below), and in the
         game it opens the form in a dialog over it (src/game/index.ts). -->
    <Button href="/#register" data-register-link>Register now</Button>
  </Window>
</div>

<script>
  /**
   * The Register window brought into view in the room under the fixed nav: centred there when it fits, else
   * (a phone, where the form is taller than the screen) its top just under the nav — never under it. In the
   * page's own scroll-behavior: a glide, or at once with reduced motion. The room is the small viewport (Safari's
   * toolbar shown), so its bottom never lands under the toolbar either.
   */
  const landOnRegister = (target: HTMLElement) => {
    const nav = document.querySelector('.nav-slot')?.getBoundingClientRect().bottom ?? 0;
    const gap = 16;
    const probe = document.createElement('div');
    probe.style.cssText = 'position:fixed;top:0;height:100svh;visibility:hidden;pointer-events:none';
    document.body.append(probe);
    const room = Math.min(window.innerHeight, probe.getBoundingClientRect().height || window.innerHeight);
    probe.remove();
    const r = target.getBoundingClientRect();
    const free = room - nav - 2 * gap;
    const at = r.height <= free ? nav + gap + (free - r.height) / 2 : nav + gap;
    window.scrollTo({ top: window.scrollY + r.top - at });
    target.focus({ preventScroll: true });
  };

  // Arriving at /#register from another page (the 404's nav): the form in view as the click brings it here,
  // once the page above it has its height. The browser's own scroll to the hash heads for the form's top
  // edge; this one takes over from it, so the page glides on instead of jumping.
  if (location.hash === '#register') {
    const centre = () => {
      const target = document.getElementById('register');
      if (target) landOnRegister(target);
    };
    if (document.readyState === 'complete') centre();
    else window.addEventListener('load', centre, { once: true });
  }

  // "Register now" brings the Register window into view under the nav (landOnRegister) and moves focus there.
  // In the game it opens the form in a dialog over it instead (src/game/index.ts).
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-register-link]')) {
    link.addEventListener('click', (e) => {
      const root = document.documentElement;
      if (root.classList.contains('is-playing')) return;
      // (zooming out of the game, or the finale carrying the page down to the form itself)
      if (root.classList.contains('is-exiting') || root.classList.contains('is-finale')) {
        e.preventDefault();
        return;
      }
      const target = document.getElementById('register');
      if (!target) return;
      e.preventDefault();
      landOnRegister(target);
    });
  }
</script>

<style>
  .nav-slot {
    position: fixed;
    top: var(--space-2);
    left: 50%;
    z-index: 20;
    width: min(100% - 2 * var(--gutter), var(--container));
    translate: -50% 0;
  }

  .nav :global(.window__body) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
  }

  /* Just the wordmark (the letters alone: the daisy is the hero's), the way vega.io's nav shows just its logo. */
  .nav__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .nav :global(.btn) {
    margin-left: auto;
  }
</style>
