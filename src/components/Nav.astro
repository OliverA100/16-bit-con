---
import Window from './Window.astro';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
---

<div class="nav-slot">
  <Window as="nav" bare title="16-BIT CON · OCT 3–5, 2026" id="site-nav" class="nav" aria-label="Primary">
    <a class="nav__brand" href="/">
      <img src="/favicon.svg" alt="" width="20" height="18" />
      <Wordmark size="nav" />
    </a>
    <Button href="#register">Register now</Button>
  </Window>
</div>

<style>
  .nav-slot {
    position: fixed;
    top: var(--space-2);
    left: 50%;
    z-index: 20;
    width: min(100% - 2 * var(--gutter), var(--container));
    translate: -50% 0;
  }

  .nav :global(.window__body) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    line-height: 1;
    text-decoration: none;
  }

  .nav :global(.btn) {
    margin-left: auto;
  }
</style>
