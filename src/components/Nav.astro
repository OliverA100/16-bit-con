---
import Window from './Window.astro';
import Button from './Button.astro';
---

<div class="nav-slot">
  <Window as="nav" title="16-BIT CON · OCT 3–5, 2026" id="site-nav" class="nav" aria-label="Primary">
    <a class="nav__brand" href="/">
      <img src="/favicon.svg" alt="" width="20" height="18" />
      <span>16-Bit Con</span>
    </a>
    <ul class="nav__links">
      <li><a href="#schedule">Schedule</a></li>
      <li><a href="#booth">Booth 630</a></li>
    </ul>
    <Button href="#register" size="sm">Register now</Button>
  </Window>
</div>

<style>
  .nav-slot {
    position: fixed;
    top: var(--space-2);
    left: 50%;
    z-index: 20;
    width: min(100% - 2 * var(--gutter), var(--container));
    translate: -50% 0;
  }

  .nav :global(.window__body) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-pixel);
    font-size: var(--text-lg);
    line-height: 1;
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    gap: var(--space-4);
    margin-left: auto;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .nav__links a {
    text-decoration: none;
  }

  .nav__links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .nav__links {
      display: none;
    }

    .nav :global(.btn) {
      margin-left: auto;
    }
  }
</style>
