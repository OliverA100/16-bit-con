---
/**
 * FlyerDialog — the flyer Sam picks up at the start of the game, opened over the world. It is a sheet of
 * paper, not a Window: the cream of Vega's poster art in an orange band and a green rule, a strip of tape
 * at the top, tilted a little, with a yellow "Free entry" burst on its right edge. A native modal <dialog>
 * like the Register one (focus trapped, the page inert, no backdrop); "Let's go" and Esc close it
 * (src/game/flyer-dialog.ts). Only in play mode.
 *
 * Type: Mondwest throughout (it is what the game shows Sam); the con's own wordmark in Yellow 600 with a
 * Green 900 outline. The arcade machine at a whole-number scale, crisp.
 */
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
---

<dialog class="flyer-dialog" aria-labelledby="flyer-title" data-flyer-dialog>
  <div class="flyer-dialog__stack" data-flyer-stack>
    <article class="flyer">
      <span class="flyer__tape" aria-hidden="true"></span>
      <p class="flyer__kicker">Calling all players</p>
      <h2 class="flyer__title" id="flyer-title"><Wordmark size="flyer" tone="flyer" /></h2>
      <img class="flyer__art" src="/sprites/props/arcade-machine.png" width="53" height="87" alt="An arcade machine with VEGA on its marquee" />
      <p class="flyer__date">Oct 3–5, 2026</p>
      <p class="flyer__place">Javits Center, New York</p>
      <p class="flyer__burst"><span class="flyer__burst-big">Free</span> <span class="flyer__burst-small">entry</span></p>
    </article>
    <Button size="page" class="flyer__go" data-flyer-go>Let’s go</Button>
  </div>
</dialog>

<style>
  /* ── The dialog: centred over the world, no backdrop. Below 64rem (where the HUD would meet it) its top
        sits under the HUD instead. ── */
  .flyer-dialog {
    width: min(23.5rem, 100% - 2 * var(--gutter));
    max-width: none;
    max-height: calc(100dvh - 2 * var(--space-4));
    margin: auto;
    padding: var(--space-4) var(--space-3) var(--space-2);
    overflow: visible;
    background: none;
    border: 0;
    color: var(--text);
  }

  .flyer-dialog::backdrop {
    background: transparent;
  }

  @media (max-width: 64rem) {
    .flyer-dialog {
      margin-top: calc(var(--nav-h) + var(--space-4) + 5rem + var(--space-2));
      max-height: calc(100dvh - var(--nav-h) - var(--space-4) - 5rem - var(--space-4));
    }
  }

  .flyer-dialog__stack {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }

  /* ── The paper: an 8 px margin of paper, a 6 px orange band, a 6 px green rule, all inset shadows over its
        cream, and a hard drop shadow of the ink at a third, so the world shows through it. ── */
  .flyer {
    --flyer-edge: 20px;
    position: relative;
    container-type: inline-size;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: calc(var(--flyer-edge) + var(--space-5)) calc(var(--flyer-edge) + var(--space-5)) calc(var(--flyer-edge) + var(--space-5));
    background: var(--color-paper);
    color: var(--color-green-900);
    text-align: center;
    rotate: -2deg;
    box-shadow:
      inset 0 0 0 8px var(--color-paper),
      inset 0 0 0 14px var(--color-yellow-600),
      inset 0 0 0 20px var(--color-green-500),
      6px 6px 0 color-mix(in srgb, var(--color-green-900) 30%, transparent);
  }

  /* A strip of clear tape over the top edge */
  .flyer__tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 84px;
    height: 24px;
    translate: -50% 0;
    rotate: 3deg;
    background: color-mix(in srgb, var(--color-daisy-white) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-cloud-white) 80%, transparent);
    pointer-events: none;
  }

  .flyer p,
  .flyer h2 {
    margin: 0;
  }

  .flyer__kicker,
  .flyer__place {
    font-family: var(--font-pixel);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .flyer__title {
    width: 100%;
    /* the outline's 2 px outside the letters */
    padding-inline: 2px;
  }

  /* One line at any width: as large as the inner column allows (it measures 5.6 em in Mondwest; 100cqi is the column inside the padding), 2.5rem at most. */
  .flyer__date {
    font-family: var(--font-pixel);
    font-size: min(2.5rem, calc(100cqi / 5.8));
    line-height: 1;
    white-space: nowrap;
  }

  /* The arcade machine at 3× where there is room, else 2× (never between: crisp pixels only). */
  .flyer__art {
    display: block;
    width: 106px;
    height: 174px;
    image-rendering: pixelated;
  }

  @media (min-width: 48rem) and (min-height: 50rem) {
    .flyer__art {
      width: 159px;
      height: 261px;
    }
  }

  @media (max-height: 44rem) {
    .flyer__art {
      width: 53px;
      height: 87px;
    }
  }

  /* "Free entry": a yellow burst over the right edge, a third of the way down. */
  .flyer__burst {
    position: absolute;
    top: 32%;
    right: -30px;
    display: grid;
    place-content: center;
    width: 84px;
    height: 84px;
    rotate: 12deg;
    background: var(--color-yellow-400);
    clip-path: polygon(50% 0%, 59% 13%, 75% 7%, 76% 24%, 93% 25%, 87% 41%, 100% 50%, 87% 59%, 93% 75%, 76% 76%, 75% 93%, 59% 87%, 50% 100%, 41% 87%, 25% 93%, 24% 76%, 7% 75%, 13% 59%, 0% 50%, 13% 41%, 7% 25%, 24% 24%, 25% 7%, 41% 13%);
    font-family: var(--font-pixel);
    line-height: 1;
    text-align: center;
  }

  .flyer__burst-big {
    display: block;
    font-size: 1.375rem;
  }

  .flyer__burst-small {
    display: block;
    font-size: 0.875rem;
  }

  /* ── In and out: it opens out of the little flyer Sam picked up (--from-x/y/s, set as it opens), and
        steps back out up and away when it closes, as the Register dialog does. ── */
  @media (prefers-reduced-motion: no-preference) {
    .flyer-dialog[open] .flyer-dialog__stack {
      animation: flyer-in 260ms var(--ease-lift);
    }

    .flyer-dialog.is-closing .flyer-dialog__stack {
      animation: flyer-out calc(3 * var(--beat)) var(--steps-3) forwards;
    }
  }

  @keyframes flyer-in {
    from {
      opacity: 0;
      transform: translate(var(--from-x, 0px), var(--from-y, 0px)) scale(var(--from-s, 0.9));
    }

    40% {
      opacity: 1;
    }
  }

  @keyframes flyer-out {
    to {
      opacity: 0;
      translate: 0 -12px;
    }
  }
</style>
