---
/**
 * Button — vega.io's button: the shared `.ui-button` (global.css: size, type, the lift on hover and
 * keyboard focus) as a link or a button.
 *   primary — Florets Yellow, no edge (the call to action)
 *   ghost   — Cloud White with the 1 px inset ring
 * Renders an <a> when `href` is given, otherwise a <button>.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'ghost';
  class?: string;
  [key: string]: unknown;
}

const { href, type = 'button', variant = 'primary', class: className, ...rest } = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element
  class:list={['btn', 'ui-button', `btn--${variant}`, className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <slot />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn--primary {
    --ui-button-ring: 0 0 0 0 transparent;
    background: var(--accent);
  }
</style>
