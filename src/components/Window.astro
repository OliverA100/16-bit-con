---
/**
 * Window — the one container of the site, drawn to the brand's window frame at the scale vega.io
 * uses it (measured on vega.io/careers at 1440 px): a 1 px Green 900 frame with a 4 px hard
 * offset shadow, no radius, a Cloud White body, and a 33 px title bar (its 1 px rule included,
 * 6 × 8 px padding) with the title centred in 13 px Geist Mono as written and three notched
 * 18 px squares on the right, 4 px apart.
 *
 * `size="compact"`: the one-square frame for small UI (HUD, rail, PRESS START, Agent Sam), as
 * vega.io's notepad.exe. `bare`: the frame without a title bar, as vega.io's own nav.
 * The title sits left on a full window and centred on a compact one; `titleAlign` overrides it (the
 * Register window keeps a centred title).
 * `closable`: inside a <dialog> the three squares give way to one close button (`data-window-close`): the
 * same pixel square filled in the close red, no icon, like Vega's notepad.exe; anywhere else the squares stay and the
 * button is not shown.
 */
type Tag = 'div' | 'section' | 'article' | 'nav' | 'aside' | 'header' | 'footer' | 'form';

interface Props {
  title: string;
  as?: Tag;
  tone?: 'light' | 'dark';
  size?: 'full' | 'compact';
  /** No title bar (the title stays for assistive tech). */
  bare?: boolean;
  id?: string;
  class?: string;
  /** Remove body padding when the content is an image or a canvas crop. */
  flush?: boolean;
  /** In a <dialog>, the third square is the close button. */
  closable?: boolean;
  /** The title's place in the bar: left on a full window, centred on a compact one, unless set. */
  titleAlign?: 'start' | 'center';
  [key: string]: unknown;
}

const {
  title,
  as: Element = 'div',
  tone = 'light',
  size = 'full',
  bare = false,
  id,
  class: className,
  flush = false,
  closable = false,
  titleAlign,
  ...rest
} = Astro.props;

const titleId = id ? `${id}-title` : undefined;
const squares = size === 'compact' ? 1 : 3;
const titleStart = (titleAlign ?? (size === 'compact' ? 'center' : 'start')) === 'start';
---

<Element
  class:list={['window', `window--${tone}`, `window--${size}`, { 'window--flush': flush, 'window--bare': bare, 'window--title-start': titleStart }, className]}
  id={id}
  aria-labelledby={titleId}
  {...rest}
>
  {
    bare ? (
      <span class="sr-only" id={titleId}>{title}</span>
    ) : (
      <div class="window__bar">
        <span class="window__title" id={titleId}>{title}</span>
        <span class="window__squares" aria-hidden="true">
          {Array.from({ length: squares }, () => (
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              shape-rendering="crispEdges"
            >
              <path d="M20 22H4V20H20V22ZM4 20H2V4H4V20ZM22 20H20V4H22V20ZM20 4H4V2H20V4Z" />
            </svg>
          ))}
        </span>
        {
          closable && (
            <button type="button" class="window__close" aria-label="Close" data-window-close>
              <svg viewBox="0 0 24 24" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true">
                <path d="M4 2H20V4H22V20H20V22H4V20H2V4H4Z" />
              </svg>
            </button>
          )
        }
      </div>
    )
  }
  <div class="window__body">
    <slot />
  </div>
</Element>

<style>
  .window {
    background: var(--surface-card);
    color: var(--text);
    border: var(--border);
    border-radius: 0;
    box-shadow: var(--shadow-hard);
  }

  /* 33 px including the 1 px rule. The title is centred while there is room; when there isn't, the
     left column gives way first, so the title slides left rather than run under the squares (the
     right column never shrinks below them). */
  .window__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(max-content, 1fr);
    align-items: center;
    height: var(--window-bar-h);
    padding: var(--window-bar-pad);
    border-bottom: var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
    user-select: none;
  }

  /* A left title runs from the bar's start up to the squares; its text lines up with the body's (the bar's
     8 px and its own 12 px make the body's 20 px). */
  .window--title-start .window__title {
    grid-column: 1 / 3;
    justify-self: start;
    padding-inline-start: var(--space-3);
  }

  .window__title {
    grid-column: 2;
    min-width: 0;
    padding-inline: var(--space-2);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .window__squares {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    display: flex;
    flex: none;
    gap: var(--space-1);
  }

  .window__squares svg {
    display: block;
    fill: currentColor;
  }

  /* The close button: only inside a dialog, where it replaces the three squares. A 24 px hit area round the
     squares' own pixel square (its corner pixels cut), filled in the close red (Vega's notepad.exe); the
     page's own focus ring shows on it. */
  .window__close {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    display: none;
    place-items: center;
    width: 24px;
    height: 24px;
    /* the 24 px hit area round an 18 px square: the square sits exactly where the third square did */
    margin: -2px -3px -2px 0;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .window__close svg {
    display: block;
    fill: var(--color-close);
  }

  :global(dialog) .window__close {
    display: grid;
  }

  :global(dialog) .window__squares {
    display: none;
  }

  /* Padding through a property, so the body rule stays one class deep and a page's own
     `.x .window__body { padding }` still wins over the default. */
  .window__body {
    padding: var(--window-body-pad, var(--window-pad));
  }

  .window--compact {
    --window-body-pad: var(--window-pad-compact);
  }

  .window--flush {
    --window-body-pad: 0;
  }

  .window--dark {
    background: var(--surface-dark);
    color: var(--text-on-dark);
  }

  .window--dark .window__bar {
    color: var(--text-on-dark-accent);
    border-bottom-color: var(--color-green-700);
  }
</style>
