---
/**
 * SceneStill — a still crop of one of the worlds, composed from Vega's source layers at
 * CSS 1:1 with the same geometry the canvas uses in Phase 3 (ground line F, layer anchors
 * from src/data/layers.ts). Sky = six flat bands of the stage ramp. All images lazy.
 */
import { sprites, type SpriteEntry, type SpriteKey } from '../data/sprites.manifest';
import { skyRamps, fieldLayers, cityLayers, type SkyStage, type LayerDef } from '../data/layers';

export type Scene = 'field' | 'city' | 'night';

interface Prop {
  key: SpriteKey;
  x: number;
  bottom?: number; // art px above F
  frame?: number;
  flip?: boolean;
}

interface Props {
  scene: Scene;
  height?: number;
  class?: string;
}

const { scene, height = 176, class: className } = Astro.props;

const GROUND = 16; // art px of ground visible below F in a still
const F = height - GROUND;
const COVER = 960; // widest card a still has to fill at 1:1

const scenes: Record<Scene, { sky: SkyStage; layers: LayerDef[]; shift: Partial<Record<SpriteKey, number>>; props: Prop[] }> = {
  field: {
    sky: 'morning',
    layers: fieldLayers,
    shift: { hills: -60, daisyRow: -20 },
    props: [
      { key: 'tree', x: 318, bottom: 0 },
      { key: 'coin', x: 196, bottom: 40 },
      { key: 'coin', x: 228, bottom: 52 },
      { key: 'coin', x: 260, bottom: 40 },
      { key: 'samSide', x: 72, bottom: 0, frame: 0 },
    ],
  },
  city: {
    sky: 'afternoon',
    layers: cityLayers,
    shift: { cityFar: -120, cityTowers: -640, cityMid: -300, cityNear: -420 },
    props: [
      { key: 'subwayFront', x: 220, bottom: 0 },
      { key: 'moleCoffee', x: 150, bottom: 0, frame: 0 },
      { key: 'samSide', x: 56, bottom: 0, frame: 0 },
    ],
  },
  night: {
    sky: 'dusk',
    layers: cityLayers,
    shift: { cityFar: -400, cityTowers: -1100, cityMid: -520, cityNear: -700 },
    props: [
      { key: 'arcade', x: 300, bottom: 0 },
      { key: 'arcade', x: 356, bottom: 0 },
      { key: 'daisyIcon', x: 270, bottom: 98 },
      { key: 'vegaSignHorizontal', x: 290, bottom: 92 },
      { key: 'molePizza', x: 210, bottom: 0, frame: 0 },
      { key: 'dogBark', x: 20, bottom: 0, frame: 0, flip: true },
      { key: 'samSide', x: 96, bottom: 0, frame: 0 },
    ],
  },
};

const def = scenes[scene];
const sky = `linear-gradient(to bottom, ${skyRamps[def.sky]
  .map((c, i) => `var(${c}) ${((i / 6) * 100).toFixed(3)}% ${(((i + 1) / 6) * 100).toFixed(3)}%`)
  .join(', ')})`;

interface Placed {
  file: string;
  w: number;
  h: number;
  left: number;
  top?: number;
  bottom?: number;
  flip: boolean;
}

const placed: Placed[] = [];
for (const layer of def.layers) {
  const s: SpriteEntry = sprites[layer.key];
  const shift = def.shift[layer.key] ?? 0;
  const copies = layer.repeat === 'none' ? 1 : Math.min(4, Math.ceil((COVER - shift) / s.w));
  for (let i = 0; i < copies; i++) {
    placed.push({
      file: s.file,
      w: s.w,
      h: s.h,
      left: shift + i * s.w,
      ...(layer.anchor === 'bottom' ? { bottom: GROUND - layer.offset } : { top: F - layer.offset }),
      flip: layer.repeat === 'mirror' && i % 2 === 1,
    });
  }
}
---

<div class:list={['still', className]} style={`--h: ${height}px; --f: ${F}px; --sky: ${sky};`} aria-hidden="true">
  {
    placed.map((l) => (
      <img
        class="pixel still__layer"
        src={l.file}
        width={l.w}
        height={l.h}
        loading="lazy"
        decoding="async"
        alt=""
        style={`left: ${l.left}px; ${l.top !== undefined ? `top: ${l.top}px;` : `bottom: ${l.bottom}px;`} ${l.flip ? 'scale: -1 1;' : ''}`}
      />
    ))
  }
  {
    def.props.map((p) => {
      const s: SpriteEntry = sprites[p.key];
      const fw = s.fw ?? s.w;
      const fh = s.fh ?? s.h;
      const pitch = s.pitch ?? fw;
      const frame = p.frame ?? 0;
      return (
        <span
          class="still__prop"
          style={`left: ${p.x}px; bottom: ${GROUND + (p.bottom ?? 0)}px; width: ${fw}px; height: ${fh}px; ${p.flip ? 'scale: -1 1;' : ''}`}
        >
          <img class="pixel" src={s.file} width={s.w} height={s.h} loading="lazy" decoding="async" alt="" style={`left: ${-frame * pitch}px;`} />
        </span>
      );
    })
  }
</div>

<style>
  .still {
    position: relative;
    width: 100%;
    height: var(--h);
    overflow: hidden;
    background: var(--color-green-900);
    border-bottom: var(--border);
  }

  .still::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--f);
    background: var(--sky);
  }

  .still__layer {
    position: absolute;
    max-width: none;
  }

  .still__prop {
    position: absolute;
    overflow: hidden;
  }

  .still__prop img {
    position: absolute;
    top: 0;
    max-width: none;
  }
</style>
