---
/**
 * RegisterForm — the CTA. A real <form> with labels and inline errors (src/register/form.ts). Client-side
 * only: nothing is sent or stored. On a valid submit the window swaps to its success state. The Player 1
 * bonus line stays hidden until the world reports all 12 coins collected (src/game/index.ts).
 *
 * In the page the section's own header ("Grab your pass") introduces the window; over the game the window
 * moves into a <dialog> (src/register/register-dialog.ts), where its own head says it instead.
 */
import Window from './Window.astro';
import Button from './Button.astro';
import Ticket from './Ticket.astro';
import { PIXEL_ICONS, pixelPath } from '../data/pixel-icons';

const passes = [
  { value: 'sat', label: 'Saturday', meta: 'Oct 3' },
  { value: 'sun', label: 'Sunday', meta: 'Oct 4' },
  { value: 'mon', label: 'Monday', meta: 'Oct 5' },
  { value: 'all', label: 'All 3 days', meta: 'Oct 3–5' },
];
---

<Window as="section" title="Register" id="register" class="register" tabindex="-1" closable titleAlign="center">
  <!-- Only in the dialog: the section's header isn't on screen there. -->
  <div class="register__dialog-head">
    <h2 class="register__dialog-title">Grab your pass</h2>
    <p class="t-small register__dialog-line">Free · limited spots · Oct 3–5, 2026 · Javits Center, New York</p>
  </div>

  <form id="register-form" class="register__form" novalidate>
    <div class="field" data-field="name">
      <label class="field__label" for="reg-name">Player name</label>
      <input
        class="field__input"
        id="reg-name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength="80"
        placeholder="Sam the Mole"
        aria-describedby="reg-name-error"
        aria-required="true"
      />
      <p class="field__msg" id="reg-name-error" aria-live="polite"></p>
    </div>

    <div class="field" data-field="email">
      <label class="field__label" for="reg-email">Email</label>
      <input
        class="field__input"
        id="reg-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        autocapitalize="off"
        placeholder="sam@vega.io"
        aria-describedby="reg-email-error"
        aria-required="true"
      />
      <p class="field__msg" id="reg-email-error" aria-live="polite"></p>
    </div>

    <fieldset class="field register__passes" data-field="pass" aria-describedby="reg-pass-error" aria-required="true" role="radiogroup">
      <legend>Pass</legend>
      <div class="register__options">
        {
          passes.map((t) => (
            <label class="option ui-button">
              <input type="radio" name="pass" value={t.value} aria-describedby="reg-pass-error" />
              <span class="option__label">{t.label}</span>
              <span class="option__meta">{t.meta}</span>
            </label>
          ))
        }
      </div>
      <p class="field__msg" id="reg-pass-error" aria-live="polite"></p>
    </fieldset>

    <label class="check">
      <input class="check__input" type="checkbox" name="news" />
      <span class="check__box" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges">
          <path d={pixelPath(PIXEL_ICONS.tick, 2, 1)} />
        </svg>
      </span>
      <span class="t-small check__label">Email me news and offers from 16-Bit Con and Vega.</span>
    </label>

    <div class="register__actions">
      <Button type="submit" size="page" class="register__submit" data-register-submit>
        <span class="register__submit-text">Register now</span>
        <span class="register__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </Button>
    </div>
  </form>

  <!-- The success state: the form's own rhythm, its heading where the first label was (src/register/success.ts). -->
  <div id="register-done" class="register__done" hidden>
    <h3 class="register__gg" id="register-gg" tabindex="-1">GG, Player 1.</h3>
    <p class="t-body register__saved">Your free pass is saved. Come say hi at Booth 630.</p>
    <Ticket class="register__ticket" />
    <p class="t-ui register__bonus" id="register-bonus" hidden>Player 1 bonus · promo code 16BIT-GG</p>
    <div class="register__actions register__done-actions">
      <Button size="page" data-register-ics>Add to calendar</Button>
      <Button size="page" variant="ghost" data-register-again>Register another player</Button>
    </div>
  </div>
</Window>

<script>
  import { startRegisterForm } from '../register/form';
  import { startSuccess } from '../register/success';

  let success: ReturnType<typeof startSuccess> = null;
  const formApi = startRegisterForm({ onRegistered: (r) => success?.show(r) });
  success = startSuccess(formApi);
</script>

<style>
  /* The page's own window: 24 px body padding (16 on phones). */
  .register {
    --window-body-pad: var(--window-pad-page);
  }

  /* "Register now" focuses the window after scrolling it into view; it is a target, not a control. */
  .register:focus {
    outline: none;
  }

  /* ── The dialog's head: in the page the section header says it, so here it shows only in the dialog ── */
  .register__dialog-head {
    display: none;
    gap: var(--rhythm-label);
    margin-bottom: var(--rhythm-block);
    text-align: left;
  }

  :global(dialog) .register__dialog-head {
    display: grid;
  }

  :global(dialog) .register:has(.register__done:not([hidden])) .register__dialog-head {
    display: none;
  }

  /* The window-heading size in Signifier: the con's own heading, as the section's */
  .register__dialog-title {
    font: var(--type-window-heading);
    font-family: var(--font-display);
    text-align: left;
  }

  .register__dialog-line {
    color: var(--text-secondary);
  }

  /* ── The form: one rhythm — 20 px between blocks (each field keeps its message line), 24 px above the button ── */
  .register__form {
    container: register-form / inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--rhythm-block);
  }

  /* The email's longest message ("Enter a valid email address, like sam@vega.io.") runs to two lines on a
     narrow form (phones), so there that field keeps two lines for it and still never moves. */
  @container register-form (max-width: 419px) {
    [data-field='email'] .field__msg {
      min-height: calc(2 * var(--leading-ui));
    }
  }

  .register__passes {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Each pass is a ghost `.ui-button` (global.css): the lift on hover and keyboard focus, the picked one
     filled Green 900. Four in a row, or 2 × 2 on phones; the gap leaves room for the lift. */
  .register__options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--control-gap);
  }

  @media (max-width: 40rem) {
    .register__options {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .option {
    display: grid;
    justify-items: center;
    align-content: center;
    padding: var(--space-2) var(--space-2);
    text-align: center;
  }

  .option input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    opacity: 0;
  }

  /* No pass chosen on submit: a 1 px Yellow 600 ring on each card */
  .register__passes[data-invalid='true'] .option {
    --ui-button-ring: inset 0 0 0 1px var(--error);
  }

  /* ── The checkbox: a square 16 px box, 1 px ink; checked, filled in the ink with a Cloud White pixel tick ── */
  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    width: fit-content;
    cursor: pointer;
  }

  .check__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    opacity: 0;
  }

  .check__box {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--outline);
  }

  .check__box svg {
    display: block;
    fill: var(--surface-card);
    visibility: hidden;
  }

  .check__input:checked + .check__box {
    background: var(--outline);
  }

  .check__input:checked + .check__box svg {
    visibility: visible;
  }

  /* without JS the box takes the plain fallback outline (with JS, the focus brackets go round it) */
  :global(:root:not(.has-focus-brackets)) .check__input:focus-visible + .check__box {
    outline: 2px solid var(--outline);
    outline-offset: 2px;
  }

  .check__label {
    color: var(--text-secondary);
  }

  /* ── The button row: left-aligned, 24 px under the last block; full width on phones ── */
  .register__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--control-gap);
    margin-top: calc(var(--rhythm-actions) - var(--rhythm-block));
  }

  @media (max-width: 40rem) {
    .register__actions > :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* "Registering" with three pixel dots blinking in turn, on the 16-bit beat */
  .register__dots {
    display: none;
    gap: 3px;
    align-items: flex-end;
    height: 12px;
    margin-left: calc(-1 * var(--space-1));
  }

  .register__dots i {
    width: 3px;
    height: 3px;
    background: currentColor;
    animation: register-dot 600ms steps(1, end) infinite;
  }

  .register__dots i:nth-child(2) {
    animation-delay: 150ms;
  }

  .register__dots i:nth-child(3) {
    animation-delay: 300ms;
  }

  @keyframes register-dot {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  :global(.register__submit[aria-disabled='true']) {
    cursor: progress;
  }

  :global(.register__submit[aria-disabled='true']) .register__dots {
    display: inline-flex;
  }

  /* ── The success state: the heading, 8 px, the line, 20 px, the ticket, (20 px, the bonus,) 24 px, the buttons ── */
  .register__done {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  /* Focus lands on the heading so screen readers read the confirmation; it is not a control. */
  .register__gg:focus,
  .register__gg:focus-visible {
    outline: none;
    box-shadow: none;
  }

  /* The window-heading role in Mondwest: the game is the one saying GG */
  .register__gg {
    font: var(--type-window-heading);
    text-align: left;
  }

  .register__saved {
    margin-top: var(--rhythm-label);
    color: var(--text-secondary);
  }

  .register__done > :global(.register__ticket) {
    margin-top: var(--rhythm-block);
  }

  .register__bonus {
    margin-top: var(--rhythm-block);
  }

  .register__done-actions {
    margin-top: var(--rhythm-actions);
  }

</style>
