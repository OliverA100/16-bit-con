---
/**
 * RegisterForm — the CTA. A real <form> with labels, required fields and inline errors.
 * Client-side validation only: nothing is sent or stored. On a valid submit the window
 * swaps to a one-line confirmation. The Player 1 bonus line stays hidden until the world
 * reports all 12 coins collected (src/game/index.ts).
 */
import Window from './Window.astro';
import Button from './Button.astro';

const tickets = [
  { value: 'sat', label: 'Saturday', meta: 'Oct 3' },
  { value: 'sun', label: 'Sunday', meta: 'Oct 4' },
  { value: 'mon', label: 'Monday', meta: 'Oct 5' },
  { value: 'all', label: '3-day pass', meta: 'Oct 3–5' },
];
---

<Window as="section" title="Register" id="register" class="register" aria-labelledby="register-heading" tabindex="-1" closable>
  <h3 id="register-heading" class="register__heading">Player 1, enter your details</h3>

  <form id="register-form" class="register__form" novalidate>
    <div class="field" data-field="name">
      <label for="reg-name">Player name</label>
      <input id="reg-name" name="name" type="text" autocomplete="name" minlength="2" required aria-describedby="reg-name-error" />
      <p class="field__error" id="reg-name-error" aria-live="polite"></p>
    </div>

    <div class="field" data-field="email">
      <label for="reg-email">Email</label>
      <input id="reg-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="reg-email-error" />
      <p class="field__error" id="reg-email-error" aria-live="polite"></p>
    </div>

    <fieldset class="field register__tickets" data-field="ticket" aria-describedby="reg-ticket-error">
      <legend>Ticket type</legend>
      <div class="register__options" role="presentation">
        {
          tickets.map((t) => (
            <label class="option ui-button">
              <input type="radio" name="ticket" value={t.value} required />
              <span class="option__label">{t.label}</span>
              <span class="option__meta">{t.meta}</span>
            </label>
          ))
        }
      </div>
      <p class="field__error" id="reg-ticket-error" aria-live="polite"></p>
    </fieldset>

    <div class="register__actions">
      <Button type="submit">Register now</Button>
    </div>
  </form>

  <div id="register-done" class="register__done" hidden tabindex="-1">
    <p class="register__gg">GG. See you at Booth 630.</p>
    <p class="mono register__ticket" id="register-ticket"></p>
    <p class="eyebrow register__bonus" id="register-bonus" hidden>Player 1 bonus · promo code 16BIT-GG</p>
    <div class="register__again">
      <Button id="register-again" variant="ghost">Register another player</Button>
    </div>
  </div>
</Window>

<script>
  const form = document.getElementById('register-form') as HTMLFormElement | null;
  const done = document.getElementById('register-done') as HTMLDivElement | null;
  const title = document.getElementById('register-title');
  const heading = document.getElementById('register-heading');

  if (form && done) {
    const field = (name: string) => form.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
    const errorEl = (name: string) => field(name).querySelector<HTMLElement>('.field__error')!;

    const validators: Record<string, () => string> = {
      name: () => {
        const v = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
        return v.length >= 2 ? '' : 'Player name needs 2+ characters.';
      },
      email: () => {
        const v = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? '' : 'Enter a valid email, like sam@vega.io.';
      },
      ticket: () => (form.querySelector<HTMLInputElement>('input[name="ticket"]:checked') ? '' : 'Pick a ticket.'),
    };

    const show = (name: string, message: string) => {
      const wrap = field(name);
      wrap.dataset.invalid = message ? 'true' : 'false';
      errorEl(name).textContent = message ? `! ${message}` : '';
      wrap.querySelectorAll('input').forEach((input) => input.setAttribute('aria-invalid', message ? 'true' : 'false'));
    };

    const validate = (name: string) => {
      const message = validators[name]!();
      show(name, message);
      return !message;
    };

    // Re-validate a field once it has been flagged, so errors clear as the player types; check a
    // field when the player leaves it with something in it, and the ticket as soon as one is picked.
    for (const name of Object.keys(validators)) {
      field(name).addEventListener('input', () => {
        if (field(name).dataset.invalid === 'true') validate(name);
      });
    }
    for (const name of ['name', 'email']) {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      input.addEventListener('blur', () => {
        if (input.value.trim() !== '') validate(name);
      });
    }
    field('ticket').addEventListener('change', () => validate('ticket'));

    const ticketLine = document.getElementById('register-ticket');
    const again = document.getElementById('register-again');
    again?.addEventListener('click', () => {
      form.reset();
      for (const name of Object.keys(validators)) show(name, '');
      done.hidden = true;
      form.hidden = false;
      if (heading) heading.hidden = false;
      if (title) title.textContent = 'Register';
      (form.elements.namedItem('name') as HTMLInputElement).focus();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const results = Object.keys(validators).map((name) => [name, validate(name)] as const);
      const firstInvalid = results.find(([, ok]) => !ok);
      if (firstInvalid) {
        field(firstInvalid[0]).querySelector<HTMLInputElement>('input')?.focus();
        return;
      }
      const picked = form.querySelector<HTMLInputElement>('input[name="ticket"]:checked')!.closest('.option')!;
      const label = picked.querySelector('.option__label')?.textContent ?? '';
      const meta = picked.querySelector('.option__meta')?.textContent ?? '';
      if (ticketLine) ticketLine.textContent = `Ticket: ${label} · ${meta}`;
      form.hidden = true;
      if (heading) heading.hidden = true;
      done.hidden = false;
      if (title) title.textContent = 'Registered · GG';
      done.focus();
    });
  }
</script>

<style>
  /* "Register now" focuses the window after scrolling it into view; it is a target, not a control. */
  .register:focus {
    outline: none;
  }

  .register__heading {
    margin-bottom: var(--space-4);
    text-align: left;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: var(--leading-title);
  }

  .register__form {
    display: grid;
    gap: var(--space-4);
  }

  .register__tickets {
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* A legend isn't a grid item, so it takes the label-to-field gap and left edge by hand. */
  .register__tickets > legend {
    margin-bottom: var(--space-1);
    padding: 0;
  }

  /* Each ticket is a ghost `.ui-button` (global.css): the lift on hover and keyboard focus, the
     picked one inverted to Green 900. Four in a row, or 2 × 2 on phones; the gap leaves room for
     the lift. */
  .register__options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 40rem) {
    .register__options {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .option {
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
  }

  .option input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    opacity: 0;
  }

  .register__tickets[data-invalid='true'] .option {
    --ui-button-ring: inset 0 0 0 2px var(--outline);
  }

  .register__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-top: var(--space-2);
    border-top: var(--border);
  }

  .register__done {
    display: grid;
    gap: var(--space-2);
  }

  /* Focus lands here only so screen readers read the confirmation; it is not a control. */
  .register__done:focus,
  .register__done:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .register__ticket {
    font-size: var(--text-sm);
  }

  .register__again {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border);
  }

  .register__gg {
    font-family: var(--font-pixel);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }
</style>
