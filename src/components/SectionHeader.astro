---
/**
 * SectionHeader — every section's header: the title (an h2 in Signifier, the con's own voice) and its
 * subheading, 16 px apart, centred. No eyebrows on sections. The header to its content is the section's
 * own --head-to-content. It doesn't animate: it is simply there.
 */
interface Props {
  title: string;
  sub?: string;
  id: string;
  class?: string;
}

const { title, sub, id, class: className } = Astro.props;
---

<header class:list={['section-head', className]}>
  <h2 class="section-head__title" id={id}>{title}</h2>
  {sub && <p class="section-head__sub">{sub}</p>}
</header>

<style>
  .section-head {
    display: grid;
    justify-items: center;
    gap: var(--head-gap);
    text-align: center;
  }

  .section-head__title {
    font: var(--type-title);
    color: var(--text);
    text-wrap: balance;
  }

  .section-head__sub {
    max-width: var(--sub-max);
    font: var(--type-sub);
    color: var(--text-secondary);
    text-wrap: balance;
  }
</style>
