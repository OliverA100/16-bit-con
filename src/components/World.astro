---
/**
 * World — the opening and, when JS runs, the canvas world pinned under it.
 * The opening is real DOM on the Daisy White page: the eyebrow and the wordmark above the monitor,
 * the tagline below, PRESS START laid on the monitor's screen. The monitor is a poster painted into
 * a canvas (so it is never the LCP element) until the 3D takes over; with the world live, the
 * canvas world sits under the opening and the overlays come in as it plays.
 */
import Window from './Window.astro';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
import { sessions } from '../data/sessions';
import { railStops, type RailIcon } from '../data/guide';
import { POSTER } from '../monitor/poster';

/** Thin outline icons for the rail, 16 × 16, 2 px strokes (brand rule: outline icons with mono labels). */
const icons: Record<RailIcon, string> = {
  sun: '<circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.5 1.5M11.5 11.5L13 13M13 3l-1.5 1.5M4.5 11.5L3 13"/>',
  city: '<path d="M2 15V6h4v9M6 15V2h5v13M11 15V8h3v7M1 15h14"/>',
  moon: '<path d="M11 2a6 6 0 1 0 3 8A5 5 0 0 1 11 2z"/>',
  crt: '<rect x="1" y="2" width="14" height="10"/><path d="M4 5l2 2-2 2M6 15h4M8 12v3"/>',
  booth: '<rect x="2" y="2" width="12" height="6"/><path d="M8 8v7M5 15h6"/>',
  ticket: '<path d="M1 4h14v3a1 1 0 0 0 0 2v3H1V9a1 1 0 0 0 0-2z"/><path d="M10 4v8" stroke-dasharray="1 1"/>',
};

const level1 = sessions[0]!;
const level2 = sessions[1]!;
const level3 = sessions[2]!;

const pct = (v: number) => `${+(v * 100).toFixed(3)}%`;
const posterStyle = `left: ${pct(POSTER.left)}; top: ${pct(POSTER.top)}; width: ${pct(POSTER.width)}; height: ${pct(POSTER.height)};`;
const monitorLabel = 'A yellow late-80s computer monitor with the 16-Bit Con game on its screen';
---

<section class="hero world" id="world" aria-labelledby="hero-title" data-world>
  <canvas class="world__canvas pixel" aria-hidden="true"></canvas>

  <div class="hero__stage" data-stage>
    <canvas class="hero__gl" aria-hidden="true" data-gl></canvas>
    <div class="hero__hit" aria-hidden="true" data-hit></div>
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">October 3–5, 2026 · Javits Center, New York</p>
      <Wordmark as="h1" size="hero" id="hero-title" />
    </div>
    <div class="hero__monitor" style={`--slot-aspect: ${1 / POSTER.slotAspect};`} data-monitor>
      <canvas
        class="hero__poster"
        width={POSTER.w}
        height={POSTER.h}
        style={posterStyle}
        role="img"
        aria-label={monitorLabel}
        data-poster
        data-off="/monitor/monitor-off.webp"
        data-on="/monitor/monitor-on.webp"></canvas>
      <noscript><img class="hero__poster" src="/monitor/monitor-on.webp" width={POSTER.w} height={POSTER.h} style={posterStyle} alt={monitorLabel} /></noscript>
    </div>
    <p class="hero__tagline">The retro gaming convention for people who never stopped playing.</p>
    <Window size="compact" title="Player 1" class="hero__start" data-start>
      <Button class="hero__start-btn" data-start-button>Press start</Button>
    </Window>
  </div>
  <script is:inline>
    // The poster, painted into its canvas as soon as it decodes (canvas pixels are never an LCP
    // candidate, so the wordmark stays the LCP element). Screen off while the 3D loads; screen on
    // wherever there will be no 3D. Mirrors shouldRunWorld() in src/game/index.ts, plus WebGL 2.
    (function () {
      var c = document.querySelector('[data-poster]');
      if (!c) return;
      var n = navigator;
      var live =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !(n.connection && n.connection.saveData) &&
        !((n.deviceMemory || 8) <= 2) &&
        !!window.WebGL2RenderingContext;
      var which = live ? 'off' : 'on';
      c.dataset.state = which;
      var img = new Image();
      img.decoding = 'async';
      img.onload = function () {
        if (c.dataset.state !== which) return;
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        c.dataset.painted = '1';
      };
      img.src = c.dataset[which];
    })();
  </script>

  <!-- Live-only overlays -->
  <Window title="Level 1 · 10:00 AM" class="world__session" data-session="1" aria-live="polite">
    <p class="world__session-title">{level1.title}</p>
    <p class="eyebrow">{level1.place}</p>
  </Window>
  <Window title="Level 2 · 2:00 PM" class="world__session" data-session="2" aria-live="polite">
    <p class="world__session-title">{level2.title}</p>
    <p class="eyebrow">{level2.place}</p>
  </Window>
  <Window title="Level 3 · 6:00 PM" class="world__session" data-session="3" aria-live="polite">
    <p class="world__session-title">{level3.title}</p>
    <p class="eyebrow">{level3.place}</p>
  </Window>

  <Window size="compact" title="Player 1" class="world__hud" aria-label="Coins, time and level">
    <p class="world__hud-row">
      <span class="world__coin pixel" aria-hidden="true"></span>
      <span class="mono" data-hud-coins>00/12</span>
      <span class="mono world__clock" data-hud-clock>07:00 AM</span>
      <span class="mono world__level" data-hud-level>LVL 1</span>
    </p>
  </Window>

  <Window as="nav" size="compact" title="Levels" class="world__rail" aria-label="Progress">
    <ol class="rail">
      {
        railStops.map((s) => (
          <li>
            <button type="button" class="rail__stop ui-button" data-rail={s.id} data-jump={String(s.jump)} data-state="next">
              <svg class="rail__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" set:html={icons[s.icon]} />
              <span class="rail__label">{s.label}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </Window>

  <Window size="compact" title="Agent Sam" class="world__sam">
    <div class="sam-bubble">
      <canvas class="sam-bubble__portrait pixel" width="46" height="49" aria-hidden="true" data-sam-portrait></canvas>
      <p class="mono sam-bubble__text" aria-hidden="true" data-sam-typed></p>
      <p class="sr-only" aria-live="polite" data-sam-said></p>
    </div>
  </Window>

  <p class="eyebrow world__hint" aria-hidden="true">← → run · space jump · scroll to play</p>

  <Window title="BREAK OUT · 0/6" class="world__prompt" aria-live="polite">
    <p class="world__prompt-key"><span class="world__prompt-fine">Mash space</span><span class="world__prompt-coarse">Tap to break out</span></p>
  </Window>

  <div class="world__touch" aria-hidden="true">
    <div class="world__dpad">
      <button type="button" class="world__dpad-arm world__dpad-arm--left" data-dpad="left" tabindex="-1"></button>
      <button type="button" class="world__dpad-arm world__dpad-arm--right" data-dpad="right" tabindex="-1"></button>
    </div>
    <button type="button" class="world__a" data-button="a" tabindex="-1"></button>
  </div>

  <Window title="Loading" class="world__loading" hidden>
    <p class="mono" data-loading-text>LOADING… 0%</p>
  </Window>
</section>

<script>
  import { bootWorld, shouldRunWorld } from '../game/index';
  import { queryHero, staticHero } from '../game/hero-dom';
  import { perchStill, queryPerch } from '../game/landing';

  const section = document.querySelector<HTMLElement>('[data-world]');
  const toRegister = () => document.getElementById('register')?.scrollIntoView({ block: 'start' });
  // The static page: Sam is already on the Register window.
  const perch = () => {
    const p = queryPerch();
    if (p) void perchStill(p).catch(() => {});
  };

  if (section && shouldRunWorld()) {
    bootWorld(section).catch((err) => {
      console.error('[world] boot failed, the static opening stays', err);
      document.documentElement.classList.remove('has-breakout');
      const d = queryHero(section);
      if (d && !section.classList.contains('world--live')) {
        staticHero(d);
        d.startButton.addEventListener('click', toRegister);
      }
      perch();
    });
  } else if (section) {
    // Reduced motion, save-data or a small device: the static page, the monitor powered on, and
    // PRESS START goes straight to the Register section, where Sam already stands.
    const d = queryHero(section);
    if (d) {
      staticHero(d);
      d.startButton.addEventListener('click', toRegister);
    }
    perch();
  }
</script>

<style>
  /* ── The opening: the Daisy White page with the copy as real DOM round the monitor,
        readable before anything loads. The monitor's slot is its silhouette at rest: 22 % of the
        viewport width, never under 220 px (src/monitor/spec.ts restWidth). ── */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: clip;
    background: var(--surface);
    text-align: center;
  }

  .hero__stage {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* The stack breathes with the screen's height: 24 px on a short laptop, up to 56 px on a tall
       screen, so it fills the hero rather than floating in the middle of it. */
    gap: clamp(var(--space-6), 5vh, 56px);
    min-height: 100vh;
    min-height: 100dvh;
    padding: calc(var(--nav-h) + var(--space-6)) var(--gutter) var(--space-10);
    background: var(--surface);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  /* The wordmark fills a phone's width and fits the height too, so the copy and the monitor share
     a short screen — and it stays the largest text, the LCP element, at every size. */
  .hero__copy :global(.wm--hero) {
    font-size: clamp(3rem, min(15.5vw, 13vh), 8rem);
  }

  .hero__eyebrow,
  .hero__tagline {
    color: var(--text-muted);
  }

  .hero__tagline {
    position: relative;
    z-index: 2;
    max-width: 34rem;
    font-size: var(--text-lg);
  }

  @media (max-width: 40rem) {
    .hero__tagline {
      max-width: 20rem;
      font-size: var(--text-base);
    }
  }

  .hero__monitor {
    position: relative;
    flex: none;
    width: max(22vw, 220px);
    aspect-ratio: var(--slot-aspect);
  }

  /* Phones: the wordmark already spans the width, so the monitor takes up the height the hero has
     to spare (the 3D reads the slot's box live, so it lands on this size). */
  @media (max-width: 40rem) {
    .hero__monitor {
      width: min(72vw, 280px);
    }
  }

  .hero__poster {
    position: absolute;
    max-width: none;
  }

  .hero__poster.is-hidden {
    opacity: 0;
  }

  /* The 3D: the whole stage, transparent, and no pointer events — swipes scroll, the copy stays selectable.
     It replaces the poster in one frame (no fade: two half-transparent layers would let the page through). */
  .hero__gl {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  .hero__gl.is-on {
    opacity: 1;
  }

  /* The monitor's screen as a tap target through the breakout's cracks (the 3D takes no pointer events):
     a hit, never the start of a scroll, a zoom or a long-press menu. */
  .hero__hit {
    position: absolute;
    z-index: 3;
    display: none;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .hero__hit.is-active {
    display: block;
  }

  /* At full resolution the 3D's buffer is the canvas world's, pixel for pixel: scaled like it (with a
     fractional pixel ratio the page stretches both by a hair), so the handover matches exactly. */
  .hero__gl.is-native {
    image-rendering: pixelated;
  }

  /* PRESS START: laid on the screen by a matrix3d from the camera (src/game/quad.ts) and hidden
     until the screen has powered on. Designed 8rem wide; the transform scales it with the monitor. */
  .hero__start {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 8rem;
    box-shadow: var(--shadow-hard-sm);
    text-align: left;
    transform-origin: 0 0;
    visibility: hidden;
  }

  .hero__start.is-ready {
    visibility: visible;
  }

  .hero__start :global(.window__body) {
    padding: var(--space-2);
  }

  /* The tube's scanlines run over PRESS START too, at the screen's own period (--scan, from the camera
     at rest), so it sits in the picture rather than on the glass. */
  .hero__start::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--scan, 2px) * 0.4),
      color-mix(in srgb, var(--color-outline-black) 30%, transparent) calc(var(--scan, 2px) * 0.7),
      transparent var(--scan, 2px)
    );
  }

  /* The button fills the window, and its hit area reaches past it to the window's edges and title
     bar: a comfortable target even at a phone's scale. It lifts 3 px on hover (Button.astro). */
  .hero__start :global(.hero__start-btn) {
    position: relative;
    width: 100%;
  }

  .hero__start :global(.hero__start-btn)::after {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--window-bar-h) - var(--space-2)) calc(-1 * var(--space-2)) calc(-1 * var(--space-2));
  }

  /* ── Live world: the canvas world under the opening, which lies over it and steps out as the run starts ── */
  .world__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    width: 100%;
    height: 100%;
  }

  .world--live {
    height: 100vh;
    height: 100dvh;
    min-height: 0;
  }

  .world--live .world__canvas {
    display: block;
  }

  .world--live .hero__stage {
    position: absolute;
    inset: 0;
    min-height: 0;
    will-change: opacity;
  }

  /* The enter segment (src/game/segments.ts): the copy and PRESS START go as the camera starts to dive
     (--out 0 → 1, set by the loop); then the whole opening hands over to the canvas world under it. */
  .world--live .hero__copy,
  .world--live .hero__tagline {
    opacity: calc(1 - var(--out, 0));
    translate: 0 calc(var(--out, 0) * -24px);
  }

  .world--live .hero__start {
    opacity: calc(1 - var(--out, 0));
  }

  .world--live .hero__stage.is-copy-gone .hero__start {
    visibility: hidden;
  }

  .world__session,
  .world__hud,
  .world__hint,
  .world__prompt,
  .world__rail,
  .world__sam,
  .world__loading {
    position: absolute;
    z-index: 3;
    display: none;
  }

  .world--live .world__session,
  .world--live .world__hud,
  .world--live .world__hint,
  .world--live .world__prompt,
  .world--live .world__rail,
  .world--live .world__sam {
    display: block;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-base) var(--steps-16bit),
      transform var(--dur-base) var(--steps-16bit);
  }

  .world--live .world__hint {
    pointer-events: none;
  }

  /* ── Touch surfaces: the canvas and the controls are game input — never text
        to select, never the start of a scroll, zoom or long-press menu. Overlay windows allow
        panning; the session copy stays selectable; the Arrival section below the pin is a
        normal page. ── */
  .world__canvas,
  .world__touch,
  .world__hud,
  .world__hint,
  .world__prompt,
  .world__loading,
  .world__session {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .world__session :global(.window__body) {
    user-select: text;
    -webkit-user-select: text;
  }

  .world--live .world__canvas,
  .world__dpad-arm,
  .world__a {
    touch-action: none;
  }

  .world__session,
  .world__hud,
  .world__prompt,
  .world__loading,
  .hero__start {
    touch-action: manipulation;
  }

  .world--live :is(.world__session, .world__hud, .world__hint, .world__prompt, .world__rail, .world__sam).is-visible {
    opacity: 1;
    transform: none;
  }

  /* Hidden overlays take no clicks or focus. */
  .world--live :is(.world__rail, .world__sam):not(.is-visible) {
    visibility: hidden;
  }

  /* ── Progress rail: a Levels window on the left edge, one stop per level, the current
        the current one inverted to Green 900; a click jumps the world there with no smear. Phones show the level
        in the HUD instead. ── */
  .world__rail {
    top: 50%;
    left: var(--gutter);
    translate: 0 -50%;
    user-select: none;
    -webkit-user-select: none;
  }

  .world__rail :global(.window__body) {
    padding: var(--space-3);
  }

  .rail {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each stop is a ghost `.ui-button` (global.css), like the tickets: the lift on hover and keyboard
     focus, the current one (aria-current, set with data-state) inverted to Green 900. Upcoming stops
     keep their dimmed text. */
  .rail__stop {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    text-align: left;
    white-space: nowrap;
  }

  .rail__icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .rail__stop[data-state='next'] {
    color: var(--text-subtle);
  }

  .world__level {
    display: none;
    padding-left: var(--space-2);
    border-left: var(--border);
  }

  @media (max-width: 48rem) {
    .world--live .world__rail {
      display: none;
    }

    .world__level {
      display: inline;
    }
  }

  /* ── Agent Sam: small and sticky in a corner — top right under the HUD on wide
        screens, above the controls on narrow ones — with his portrait at 2:1 and typewriter mono text. ── */
  .world__sam {
    top: calc(var(--nav-h) + var(--space-4) + 5rem + var(--space-3));
    right: var(--gutter);
    width: min(22rem, calc(100% - 2 * var(--gutter)));
    text-align: left;
    pointer-events: none;
  }

  .sam-bubble {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .sam-bubble__portrait {
    flex: none;
    width: 92px;
    height: 98px;
    border: var(--border);
    background: var(--color-blue-100);
  }

  .sam-bubble__text {
    min-height: 3lh;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  @media (max-width: 48rem) {
    .world__sam {
      top: auto;
      left: var(--gutter);
      right: var(--gutter);
      bottom: calc(76px * var(--px) + 120px);
      width: auto;
    }
  }

  @media (max-width: 40rem) {

    .sam-bubble__portrait {
      width: 46px;
      height: 49px;
    }
  }

  /* Centred at the top under the nav, on the HUD's row; where the two would meet (below 48rem) it
     drops under the HUD instead, still centred. */
  .world__prompt {
    top: calc(var(--nav-h) + var(--space-4));
    left: 50%;
    width: min(16rem, calc(100% - 2 * var(--gutter)));
    translate: -50% 0;
    text-align: center;
  }

  @media (max-width: 48rem) {
    .world__prompt {
      top: calc(var(--nav-h) + var(--space-4) + 5rem + var(--space-3));
    }
  }

  .world__prompt-key {
    font-family: var(--font-pixel);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  .world__prompt-coarse {
    display: none;
  }

  @media (pointer: coarse) {
    .world__prompt-fine {
      display: none;
    }

    .world__prompt-coarse {
      display: inline;
    }
  }

  .world__session {
    top: calc(var(--nav-h) + var(--space-4));
    left: var(--gutter);
    width: min(20rem, calc(100% - 2 * var(--gutter)));
    text-align: left;
  }

  .world__session-title {
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .world__hud {
    top: calc(var(--nav-h) + var(--space-4));
    right: var(--gutter);
  }

  @media (max-width: 40rem) {
    /* Phones: HUD first, session window stacked under it. */
    .world__session {
      top: calc(var(--nav-h) + var(--space-4) + 5rem + var(--space-3));
    }
  }

  .world__hud :global(.window__body) {
    padding: var(--space-2) var(--space-3);
  }

  .world__hud-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .world__coin {
    display: inline-block;
    width: 24px;
    height: 24px;
    background: url('/sprites/ui/anim-vega-coin-3f_80x24.png') 0 0 / 80px 24px no-repeat;
  }

  .world__clock {
    padding-left: var(--space-2);
    border-left: var(--border);
  }

  .world__hint {
    left: 50%;
    bottom: calc(130px * var(--px));
    translate: -50% 0;
    padding: var(--space-1) var(--space-2);
    background: var(--surface);
    border: var(--border);
  }

  .world__loading {
    display: block;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .world__loading[hidden] {
    display: none !important;
  }

  .world__touch {
    display: none;
  }

  @media (pointer: coarse) {
    .world--live:not(.world--opening) .world__touch {
      position: absolute;
      inset: auto var(--gutter) calc(76px * var(--px));
      z-index: 3;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      pointer-events: none;
    }

    .world__dpad,
    .world__a {
      pointer-events: auto;
      image-rendering: pixelated;
    }

    .world__dpad {
      position: relative;
      width: calc(2 * 52px);
      height: calc(2 * 53px);
      background: url('/sprites/ui/dpad.png') 0 0 / 100% 100% no-repeat;
    }

    .world__dpad-arm {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 45%;
      padding: 0;
      background: transparent;
      border: 0;
      touch-action: none;
    }

    .world__dpad-arm--left {
      left: 0;
    }

    /* Pressed: a flat Green 900 shade over the arm (no filter on the art). */
