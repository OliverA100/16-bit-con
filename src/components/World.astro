---
/**
 * World — the opening and, when JS runs, the canvas world pinned under it.
 * The opening is real DOM on the Daisy White page: the eyebrow and the wordmark above the monitor,
 * the tagline below, PRESS START laid on the monitor's screen. The monitor is a poster painted into
 * a canvas (so it is never the LCP element) until the 3D takes over; with the world live, the
 * canvas world sits under the opening. The game is opt-in: the overlays (HUD with Exit game, Skip,
 * hint, d-pad, the flyer) exist only in play mode, :root.is-playing, after PRESS START (src/game/index.ts).
 */
import Window from './Window.astro';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
import FlyerDialog from './FlyerDialog.astro';
import { POSTER } from '../monitor/poster';
import { PIXEL_ICONS, halfThick, pixelPath } from '../data/pixel-icons';

/** Icons, 16 × 16 in 2 px pixel blocks like every icon on the site (src/data/pixel-icons.ts). */
/** The HUD's icons at 1.5 px lines (vega.io's buttons): on half-pixel cells, 16.5 × 16.5 in a 17 box. */
const hudIcon = (grid: readonly string[]) => pixelPath(halfThick(grid), 0.5);
const backIcon = hudIcon(PIXEL_ICONS.back);
const skipIcon = hudIcon(PIXEL_ICONS.skip);
const soundOn = hudIcon(PIXEL_ICONS.soundOn);
const soundOff = hudIcon(PIXEL_ICONS.soundOff);

const pct = (v: number) => `${+(v * 100).toFixed(3)}%`;
const posterStyle = `left: ${pct(POSTER.left)}; top: ${pct(POSTER.top)}; width: ${pct(POSTER.width)}; height: ${pct(POSTER.height)};`;
const monitorLabel = 'A yellow late-80s computer monitor with the 16-Bit Con game on its screen';
---

<section class="hero world" id="world" aria-labelledby="hero-title" data-world>
  <canvas class="world__canvas pixel" aria-hidden="true"></canvas>

  <div class="hero__stage" data-stage>
    <canvas class="hero__gl" aria-hidden="true" data-gl></canvas>
    <div class="hero__hit" aria-hidden="true" data-hit></div>
    <!-- Over the monitor's own power button (placed there by src/game/index.ts): switches the screen off and on. -->
    <button type="button" class="hero__power" aria-label="Monitor power" aria-pressed="true" data-power hidden></button>
    <div class="hero__copy">
      <p class="t-eyebrow hero__eyebrow"><span>October 3–5, 2026</span><span class="hero__eyebrow-dot" aria-hidden="true"> · </span><span>Javits Center, New York</span></p>
      <Wordmark as="h1" size="hero" id="hero-title" />
    </div>
    <div class="hero__monitor" style={`--slot-aspect: ${1 / POSTER.slotAspect};`} data-monitor>
      <canvas
        class="hero__poster"
        width={POSTER.w}
        height={POSTER.h}
        style={posterStyle}
        role="img"
        aria-label={monitorLabel}
        data-poster
        data-off="/monitor/monitor-off.webp"
        data-on="/monitor/monitor-on.webp"></canvas>
      <noscript><img class="hero__poster" src="/monitor/monitor-on.webp" width={POSTER.w} height={POSTER.h} style={posterStyle} alt={monitorLabel} /></noscript>
    </div>
    <p class="t-lead hero__tagline">The retro gaming convention for people who never stopped playing.</p>
    <Window size="compact" title="Player 1" class="hero__start" data-start>
      <Button class="hero__start-btn" data-start-button>Start</Button>
    </Window>
  </div>
  <script is:inline>
    // The poster, painted into its canvas as soon as it decodes (canvas pixels are never an LCP
    // candidate, so the LCP element stays the opening's text). Screen off while the 3D loads; screen on
    // wherever there will be no 3D. Mirrors shouldRunWorld() in src/game/index.ts, plus WebGL 2.
    // The <script> below this section removes .has-game again if the world does not run after all.
    (function () {
      var c = document.querySelector('[data-poster]');
      if (!c) return;
      var n = navigator;
      var game =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !(n.connection && n.connection.saveData) &&
        !((n.deviceMemory || 8) <= 2);
      // the game will run: the page takes its game layout now (the Register spacing, an empty perch), not when it boots
      if (game) document.documentElement.classList.add('has-game');
      var live = game && !!window.WebGL2RenderingContext;
      var which = live ? 'off' : 'on';
      c.dataset.state = which;
      var img = new Image();
      img.decoding = 'async';
      img.onload = function () {
        if (c.dataset.state !== which) return;
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        c.dataset.painted = '1';
      };
      img.src = c.dataset[which];
    })();
  </script>

  <!-- Live-only overlays -->
  <!-- The HUD. The controls stand straight on the scene, as on vega.io's own game: Exit game and sound top
       left; Skip top right, with the Player 1 window (coins and time) under it. -->
  <div class="world__hud" role="group" aria-label="Game">
    <div class="world__controls">
      <Button variant="ghost" class="world__exit" data-exit>
        <svg class="world__icon" viewBox="0 0 17 17" width="17" height="17" shape-rendering="crispEdges" aria-hidden="true"><path d={backIcon} /></svg>
        <span>Exit game</span>
      </Button>
      <Button variant="ghost" class="world__sound" data-sound aria-label="Sound" aria-pressed="true">
        <svg class="world__icon world__sound-icon" viewBox="0 0 17 17" width="17" height="17" shape-rendering="crispEdges" aria-hidden="true">
          <path class="world__sound-waves" d={soundOn} />
          <path class="world__sound-x" d={soundOff} />
        </svg>
      </Button>
    </div>
    <div class="world__hud-right">
      <Button variant="ghost" class="world__skip" data-skip aria-label="Skip to the end of the run">
        <span>Skip</span>
        <svg class="world__icon" viewBox="0 0 17 17" width="17" height="17" shape-rendering="crispEdges" aria-hidden="true"><path d={skipIcon} /></svg>
      </Button>
      <Window size="compact" title="Player 1" class="world__player" aria-label="Coins and time">
        <p class="world__hud-row">
          <span class="world__coin pixel" aria-hidden="true"></span>
          <span class="mono" data-hud-coins>00/12</span>
          <span class="mono world__clock" data-hud-clock>07:00 AM</span>
        </p>
      </Window>
    </div>
  </div>

  <Window size="compact" title="Sam" class="world__sam">
    <div class="sam-bubble">
      <canvas class="sam-bubble__portrait pixel" width="46" height="49" aria-hidden="true" data-sam-portrait></canvas>
      <p class="mono sam-bubble__text" aria-hidden="true" data-sam-typed></p>
      <p class="sr-only" aria-live="polite" data-sam-said></p>
    </div>
  </Window>

  <!-- How to play, one line per kind of device (CSS picks by pointer); hidden while the flyer is open. -->
  <p class="t-ui world__hint" aria-hidden="true">
    <span class="world__hint-fine">← → or scroll to run · Space to jump</span>
    <span class="world__hint-touch">Hold ◀ ▶ or swipe to run · Tap A to jump</span>
  </p>

  <Window size="compact" title="Help Sam · 0/7" class="world__prompt" aria-live="polite">
    <!-- Click or tap the monitor to hit its glass (Space hits it too: said to screen readers). -->
    <p class="world__prompt-key">Hit the screen</p>
    <p class="world__prompt-sub">to break the glass<span class="sr-only">, or press Space</span></p>
  </Window>

  <div class="world__touch" aria-hidden="true">
    <div class="world__dpad">
      <button type="button" class="world__dpad-arm world__dpad-arm--left" data-dpad="left" tabindex="-1"></button>
      <button type="button" class="world__dpad-arm world__dpad-arm--right" data-dpad="right" tabindex="-1"></button>
      <svg class="world__dpad-art" viewBox="0 0 104 104" width="104" height="104">
        <rect class="dpad__body" x="35" y="2" width="34" height="100" rx="7" />
        <rect class="dpad__body" x="2" y="35" width="100" height="34" rx="7" />
        <path class="dpad__arrow" d="M52 12l9 11H43z" />
        <path class="dpad__arrow" d="M52 92l9-11H43z" />
        <path class="dpad__arrow dpad__arrow--left" d="M12 52l11-9v18z" />
        <path class="dpad__arrow dpad__arrow--right" d="M92 52l-11-9v18z" />
      </svg>
    </div>
    <button type="button" class="world__a" data-button="a" tabindex="-1">
      <svg class="world__a-art" viewBox="0 0 64 64" width="64" height="64">
        <circle class="abtn__rim" cx="32" cy="32" r="31" />
        <g class="abtn__top">
          <circle class="abtn__face" cx="32" cy="32" r="27" />
          <text class="abtn__letter" x="32" y="33" text-anchor="middle" dominant-baseline="central">A</text>
        </g>
      </svg>
    </button>
  </div>

  <!-- The flyer Sam picks up as the game starts, opened over the world (play mode only) -->
  <FlyerDialog />

  <!-- The game's mode changes, announced (the overlays' own live regions are hidden outside the game). -->
  <p class="sr-only" aria-live="polite" data-world-status></p>
</section>

<script>
  import { bootWorld, shouldRunWorld } from '../game/index';
  import { queryHero, staticHero } from '../game/hero-dom';
  import { perchStill, queryPerch } from '../game/landing';

  const section = document.querySelector<HTMLElement>('[data-world]');
  // The static page: the game is never offered (no PRESS START), and Sam is already on the Register window.
  const staticPage = (d: NonNullable<ReturnType<typeof queryHero>>) => {
    d.start.hidden = true;
    staticHero(d);
  };
  const perch = () => {
    const p = queryPerch();
    if (p) void perchStill(p).catch(() => {});
  };

  if (section && shouldRunWorld()) {
    bootWorld(section).catch((err) => {
      console.error('[world] boot failed, the static opening stays', err);
      document.documentElement.classList.remove('has-game', 'is-playing');
      const d = queryHero(section);
      if (d && !section.classList.contains('world--live')) staticPage(d);
      perch();
    });
  } else if (section) {
    document.documentElement.classList.remove('has-game');
    // Reduced motion, save-data or a small device: the static page, the monitor powered on, nothing
    // animating, and no PRESS START; Sam already stands on the Register window.
    const d = queryHero(section);
    if (d) staticPage(d);
    perch();
  }
</script>

<style>
  /* ── The opening: the Daisy White page with the copy as real DOM round the monitor,
        readable before anything loads. The monitor's slot is its silhouette at rest: 22 % of the
        viewport width, never under 220 px (src/monitor/spec.ts restWidth). ── */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: clip;
    background: var(--surface);
    text-align: center;
  }

  /* After the breakout the opening is sky too: its page-colour backgrounds clear, so the page's clouds
     (src/game/sky.ts, behind everything) drift behind the wordmark and the broken monitor. */
  :global(:root.is-done) :is(.hero, .hero__stage) {
    background: transparent;
  }

  .hero__stage {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* The stack breathes with the screen's height: 24 px on a short laptop, up to 56 px on a tall
       screen, so it fills the hero rather than floating in the middle of it. */
    gap: clamp(var(--space-6), 5vh, 56px);
    min-height: 100vh;
    min-height: 100dvh;
    padding: calc(var(--nav-h) + var(--space-6)) var(--gutter) var(--space-10);
    background: var(--surface);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  /* The wordmark fills a phone's width and fits the height too, so the copy and the monitor share
     a short screen. Its letters are as tall as the Geist caps it replaced (clamp(3rem, min(15.5vw,
     13vh), 8rem) at 0.726 em), and it is never wider than the copy column (.wm's max-width). */
  .hero__copy :global(.wm--hero) {
    --wm-w: clamp(16.5rem, min(85vw, 71vh), 44rem);
  }

  .hero__eyebrow,
  .hero__tagline {
    color: var(--text);
  }

  /* The facts line: the dates, a dot, the place. On a phone it is two lines, the dates then the place, and
     the dot between them goes (it would hang at the first line's end). */
  .hero__eyebrow span {
    white-space: nowrap;
  }

  .hero__eyebrow-dot {
    white-space: pre;
  }

  @media (max-width: 40rem) {
    .hero__eyebrow {
      display: grid;
    }

    .hero__eyebrow .hero__eyebrow-dot {
      display: none;
    }
  }

  .hero__tagline {
    position: relative;
    z-index: 2;
    max-width: var(--sub-max);
  }

  @media (max-width: 40rem) {
    .hero__tagline {
      max-width: 20rem;
    }
  }

  /* The monitor grows with the page and never shrinks as it widens: 72vw on a phone (the wordmark
     already spans the width, so it takes the height the hero has to spare) up to 280 px, held there
     until 22vw — the desktop's size — passes it. (A phone-only 280 px over a 220 px floor made it
     shrink at 641 px and only catch up at ~1270.) The 3D reads the slot's box live. */
  .hero__monitor {
    position: relative;
    flex: none;
    width: max(min(72vw, 280px), 22vw);
    aspect-ratio: var(--slot-aspect);
  }

  .hero__poster {
    position: absolute;
    max-width: none;
  }

  .hero__poster.is-hidden {
    opacity: 0;
  }

  /* The 3D: the whole stage, transparent, and no pointer events — swipes scroll, the copy stays selectable.
     It replaces the poster in one frame (no fade: two half-transparent layers would let the page through). */
  .hero__gl {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  .hero__gl.is-on {
    opacity: 1;
  }

  /* The monitor's screen as a tap target through the breakout's cracks (the 3D takes no pointer events):
     a hit, never the start of a scroll, a zoom or a long-press menu. */
  .hero__hit {
    position: absolute;
    z-index: 3;
    display: none;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The monitor's power button: a round target over the 3D button (it presses in itself), placed and sized
     by the page; only a focus ring of its own. */
  .hero__power {
    position: absolute;
    z-index: 3;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .hero__power[hidden] {
    display: none;
  }

  :global(:root.is-playing) .hero__power {
    display: none;
  }

  .hero__hit.is-active {
    display: block;
  }

  /* At full resolution the 3D's buffer is the canvas world's, pixel for pixel: scaled like it (with a
     fractional pixel ratio the page stretches both by a hair), so the handover matches exactly. */
  .hero__gl.is-native {
    image-rendering: pixelated;
  }

  /* START: a normal compact window (its shadow, its padding), laid on the screen by a matrix3d from the
     camera (src/game/quad.ts) at its true size — one CSS px per px (src/game/hero-dom.ts startRect) —
     and hidden until the screen has powered on. */
  .hero__start {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 8rem;
    text-align: left;
    transform-origin: 0 0;
    visibility: hidden;
  }

  .hero__start.is-ready {
    visibility: visible;
  }

  /* The tube's scanlines run over PRESS START too, at the screen's own period (--scan, from the camera
     at rest), so it sits in the picture rather than on the glass. */
  .hero__start::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--scan, 2px) * 0.4),
      color-mix(in srgb, var(--color-outline-black) 30%, transparent) calc(var(--scan, 2px) * 0.7),
      transparent var(--scan, 2px)
    );
  }

  /* The button fills the window, and its hit area reaches past it to the window's edges and title
     bar: a comfortable target even at a phone's scale. It lifts 3 px on hover (Button.astro). */
  .hero__start :global(.hero__start-btn) {
    position: relative;
    width: 100%;
  }

  .hero__start :global(.hero__start-btn)::after {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--window-bar-h) - var(--space-3)) calc(-1 * var(--space-4)) calc(-1 * var(--space-3));
  }

  /* ── Live world: the canvas world under the opening, which lies over it and steps out as the run starts ── */
  .world__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    width: 100%;
    height: 100%;
  }

  /* The live world's height is held by the page (--world-h, src/game/index.ts viewH): a phone's toolbar
     showing or hiding mid-scroll never resizes it, so the 3D under PRESS START never stretches. */
  .world--live {
    height: 100vh;
    height: var(--world-h, 100dvh);
    min-height: 0;
  }

  /* On a touch screen the canvas runs on below the section by the skirt (--world-skirt, src/game/index.ts):
     the ground's fill under the browser's bottom bar. Clipped by the section until the run fills the screen. */
  .world--live .world__canvas {
    display: block;
    height: calc(100% + var(--world-skirt, 0px));
  }

  :global(:root.is-playing) .world--live:not(.world--opening),
  .world--bleed {
    overflow: visible;
  }

  /* Safari 26's bars through the run on a phone. Over a pinned (fixed) box at the screen's edge it paints a
     solid strip of that box's colour; past one it shows the page as it scrolls. So the pinned section is
     hidden from it (its contents stay visible): behind the clock Safari shows the page, which takes the
     sky's colour; at the bottom edge a thin pinned strip in the ground's colour gives the bottom bar the
     ground (both src/game/index.ts). */
  @media (pointer: coarse) {
    .world--bleed {
      visibility: hidden;
    }

    /* no weight of its own, so each overlay's own hiding (not .is-visible) still wins */
    :global(:where(.world--bleed > *)) {
      visibility: visible;
    }
  }

  .world--live .hero__stage {
    position: absolute;
    inset: 0;
    min-height: 0;
    will-change: opacity;
  }

  /* The enter segment (src/game/segments.ts): the copy and PRESS START go as the camera starts to dive
     (--out 0 → 1, set by the loop); then the whole opening hands over to the canvas world under it. */
  .world--live .hero__copy,
  .world--live .hero__tagline {
    opacity: calc(1 - var(--out, 0));
    translate: 0 calc(var(--out, 0) * -24px);
  }

  /* After the breakout the copy simply fades back in where it is: no slide. */
  .world--live .hero__stage.is-settled :is(.hero__copy, .hero__tagline) {
    translate: none;
  }

  .world--live .hero__start {
    opacity: calc(1 - var(--out, 0));
  }

  .world--live .hero__stage.is-copy-gone .hero__start {
    visibility: hidden;
  }

  .world__hud,
  .world__hint,
  .world__prompt,
  .world__sam {
    position: absolute;
    z-index: 3;
    display: none;
  }

  .world--live .world__hud,
  .world--live .world__hint,
  .world--live .world__prompt,
  .world--live .world__sam {
    display: block;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-base) var(--steps-16bit),
      transform var(--dur-base) var(--steps-16bit);
  }

  .world--live .world__hint {
    pointer-events: none;
  }

  /* ── Touch surfaces: the canvas and the controls are game input — never text
        to select or a long-press menu. The controls never start a scroll or a zoom; the canvas
        scrolls vertically (that is how a phone plays). Overlay windows allow panning; the
        Arrival section below the pin is a normal page. ── */
  .world__canvas,
  .world__touch,
  .world__hud,
  .world__hint,
  .world__prompt {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .world__dpad-arm,
  .world__a {
    touch-action: none;
  }

  /* A vertical swipe on the world scrolls the page (the scroll runs the game); a tap hops (src/game/input.ts). */
  .world--live .world__canvas {
    touch-action: pan-y;
  }

  .world__hud,
  .world__prompt,
  .hero__start {
    touch-action: manipulation;
  }

  .world--live :is(.world__hud, .world__hint, .world__prompt, .world__sam).is-visible {
    opacity: 1;
    transform: none;
  }

  /* Hidden overlays take no clicks or focus (the HUD holds Exit game). */
  .world--live :is(.world__sam, .world__hud):not(.is-visible) {
    visibility: hidden;
  }

  /* The prompt keeps its box while it steps out, so it gives up its taps instead: on a phone it stands on
     the HUD's row, and unseen it would lie over Exit game and the sound button. */
  .world--live .world__prompt:not(.is-visible) {
    pointer-events: none;
  }

  /* By default the page is a landing page: nothing of the game is there, nothing in it focusable. */
  :global(:root:not(.is-playing)) :is(.world__hud, .world__hint, .world__touch, .world__sam, .world__prompt) {
    display: none !important;
  }

  /* While the flyer is open, nothing else sits on the world but the HUD: no hint, no Skip, no Sam, no controls. */
  :global(:root.is-reading) :is(.world__hint, .world__sam, .world__touch, :global(.world__skip)) {
    visibility: hidden;
    opacity: 0;
  }

  /* The controls' foot: where the overlays under the top row start. */
  .world {
    --hud-foot: calc(var(--nav-h) + var(--space-4) + var(--control-h));
  }

  /* ── Sam: small and sticky in a corner — top left under the controls on wide screens (the Player 1
        window has the right), above the touch controls on narrow ones — with his portrait at 2:1 and
        typewriter mono text. ── */
  .world__sam {
    top: calc(var(--hud-foot) + var(--space-3));
    left: var(--gutter);
    width: min(22rem, calc(100% - 2 * var(--gutter)));
    text-align: left;
    pointer-events: none;
  }

  .sam-bubble {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .sam-bubble__portrait {
    flex: none;
    width: 92px;
    height: 98px;
    border: var(--border);
    background: var(--color-blue-100);
  }

  .sam-bubble__text {
    min-height: 3lh;
    font: var(--type-line);
  }

  @media (max-width: 48rem) {
    .world__sam {
      top: auto;
      left: var(--gutter);
      right: var(--gutter);
      bottom: calc(76px * var(--px) + 120px);
      width: auto;
    }
  }

  @media (max-width: 40rem) {

    .sam-bubble__portrait {
      width: 46px;
      height: 49px;
    }
  }

  /* Centred at the top under the nav, on the HUD's row; where the two would meet (below 48rem) it
     drops under the HUD instead, still centred. */
  /* Centred in the room between the nav and the monitor's top (--prompt-top, set by the loop as it shows). */
  .world__prompt {
    top: var(--prompt-top, calc(var(--nav-h) + var(--space-4)));
    left: 50%;
    width: min(16rem, calc(100% - 2 * var(--gutter)));
    translate: -50% 0;
    text-align: center;
  }


