---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = '16-Bit Con — October 3–5, 2026, Javits Center, New York',
  description =
    'The retro gaming convention for people who never stopped playing. October 3–5, 2026 at the Javits Center, New York. Find Vega at Booth 630.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Signifier-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFAEB" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p class="eyebrow">
        16-Bit Con · Oct 3–5, 2026 · Javits Center, New York ·
        <a href="https://vega.io/16-bit-con">vega.io/16-bit-con</a>
      </p>
    </footer>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .site-footer {
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
  }
</style>
