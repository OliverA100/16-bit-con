---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';

interface Props {
  title?: string;
  description?: string;
  /** The footer with its evening field (off on the 404 page, whose cloud bank meets the window's bottom). */
  footer?: boolean;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** Where the skip link goes, and what it says: past the game on the home page, to the content elsewhere. */
  skip?: { href: string; label: string };
  /** The browser bar's colour: the page's surface, or the sky on the page that is all sky (the hex of --surface, --sky). */
  themeColor?: string;
  /** The font files the first screen sets type in, preloaded (file names in public/fonts, without .woff2). */
  fonts?: string[];
}

const {
  title = '16-Bit Con · Oct 3–5, 2026',
  description =
    'The retro gaming convention for people who never stopped playing. Talks, workshops and tournaments at the Javits Center, New York. Find Vega at Booth 630.',
  footer = true,
  noindex = false,
  fonts = ['Signifier-Variable', 'GeistMono-Variable', 'Geist-Variable'],
  themeColor = '#FFFAEB',
  skip = { href: '#main', label: 'Skip to content' },
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {fonts.map((font) => <link rel="preload" href={`/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={themeColor} />
    {!noindex && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />}
    <meta property="og:site_name" content="16-Bit Con" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="16-Bit Con, October 3–5, 2026, Javits Center, New York, vega.io/16-bit-con. Sam the mole, in blue goggles, stands in a pixel-art meadow under a blue sky, with green hills and a mesa behind him." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Every load starts at the top of the world, scroll 0: the browser does not restore the old
      // scroll position, and a reload also drops a #section hash so it cannot jump there either.
      // A fresh visit to a link with a hash (/#register) still lands on its section.
      (function () {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var reload = !!nav && nav.type === 'reload';
        if (reload && location.hash) history.replaceState(null, '', location.pathname + location.search);
        if (location.hash) return;
        var top = function () { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); };
        top();
        // ...and again as the page settles, unless the reader has already begun to scroll: never pull them back
        var touched = false;
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (type) {
          window.addEventListener(type, function () { touched = true; }, { once: true, passive: true });
        });
        var again = function () { if (!touched) top(); };
        window.addEventListener('DOMContentLoaded', again, { once: true });
        window.addEventListener('load', again, { once: true });
      })();
    </script>
    <script is:inline>
      // World art scale for DOM-placed world art (hero platform, Sam). Mirrors worldBuffer()
      // in src/game/scale.ts: k = clamp(round(deviceH / 540), 2, 6), 240 px width floor.
      (function () {
        var root = document.documentElement;
        // The height is held through a height-only resize on a touch screen (the toolbar showing or hiding, a
        // keyboard opening), as the game holds its own: Sam and the footer's field never change size under a thumb.
        var touch = navigator.maxTouchPoints > 0 || matchMedia('(pointer: coarse)').matches;
        var lastW = window.innerWidth;
        var heldH = window.innerHeight;
        function fit() {
          if (window.innerWidth !== lastW || !touch) heldH = window.innerHeight;
          lastW = window.innerWidth;
          var dpr = window.devicePixelRatio || 1;
          var devW = Math.round(window.innerWidth * dpr);
          var devH = Math.round(heldH * dpr);
          var k = Math.min(6, Math.max(2, Math.round(devH / 540)));
          if (Math.ceil(devW / k) < 240) k = Math.max(2, k - 1);
          root.style.setProperty('--px', String(k / dpr));
          // Sam's own scale on the page (the Register window, the footer's field, the beanstalk): the same k
          root.style.setProperty('--sam-px', k / dpr + 'px');
        }
        fit();
        window.addEventListener('resize', fit, { passive: true });
      })();
    </script>
  </head>
  <body>
    <Button href={skip.href} class="skip-link">{skip.label}</Button>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && (
      <footer class="site-footer">
        <div class="site-footer__text container">
          <!-- The host: Vega's own logo, wordmark and daisy together, as Vega draws it. -->
          <p class="site-footer__host">
            <span class="t-ui">Hosted by</span>
            <a href="https://vega.io" class="site-footer__vega">
              <img src="/sprites/ui/vega-logo.svg" alt="Vega" width="487" height="158" loading="lazy" decoding="async" />
            </a>
          </p>
          <p class="t-ui site-footer__info">
            16-Bit Con · Oct 3–5, 2026 · Javits Center, New York · Booth 630 ·{' '}
            <a href="https://vega.io/16-bit-con">vega.io/16-bit-con</a>
          </p>
        </div>
        <!-- Vega's golden evening field under the text, at Sam's scale (src/page/footer.ts); Sam ends up on its path. -->
        <div class="site-footer__scene" aria-hidden="true" data-footer-scene>
          <canvas class="site-footer__back" data-footer-back></canvas>
          <canvas class="site-footer__front" data-footer-front></canvas>
          <noscript><div class="site-footer__still"></div></noscript>
        </div>
      </footer>
    )}
  </body>
</html>

<script>
  import { startFocusBrackets } from '../ui/focus-brackets';

  startFocusBrackets();
</script>

<script>
  import { startFooter } from '../page/footer';

  startFooter().catch((err) => console.error('[footer] the field did not load', err));
</script>

<style>
  main:focus {
    outline: none;
  }

  /* No z-index here: the field's two canvases take part in the page's own stacking, so the beanstalk's
     foot (src/page/stalk.ts) stands between the hills and the grass, and Sam in front of both. */
  .site-footer {
    position: relative;
  }

  .site-footer__text {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    padding: var(--space-12) 0 var(--space-6);
    text-align: center;
  }

  /* The field whole: 230 art rows at Sam's scale — the daisies' heads, the clouds, the golden hills and all of
     the meadow (its surface, the ground line, 45 rows over the bottom: src/page/footer.ts). The art in this
     band only, the text's clear zone above it. */
  .site-footer__scene {
    position: relative;
    height: calc(230 * var(--sam-px, 2px));
    overflow: hidden;
  }

  .site-footer__scene canvas {
    position: absolute;
    bottom: 0;
    left: 0;
    image-rendering: pixelated;
  }

  .site-footer__back {
    z-index: 1;
  }

  .site-footer__front {
    z-index: 5;
  }

  /* Without JS: the same field, still, from CSS layers of the same files (the ground 185 rows down the band). */
  .site-footer__still {
    position: absolute;
    inset: 0;
    --a: var(--sam-px, 2px);
    background-image:
      url('/sprites/world/ground-desert-strip_509x51.png'),
      url('/sprites/world/bg-hills-golden_509x121.png'),
      url('/sprites/world/cloud-lg_207x130.png');
    background-repeat: repeat-x, repeat-x, no-repeat;
    background-size:
      calc(509 * var(--a)) calc(51 * var(--a)),
      calc(509 * var(--a)) calc(121 * var(--a)),
      calc(207 * var(--a)) calc(130 * var(--a));
    background-position:
      0 calc(179 * var(--a)),
      0 calc(76 * var(--a)),
      40% 0;
    image-rendering: pixelated;
  }

  .site-footer__host {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  /* The info line in Grey 700, its link in the ink, underlined. */
  .site-footer__info {
    color: var(--text-secondary);
  }

  .site-footer__info a {
    color: var(--text);
    text-decoration: underline;
    white-space: nowrap; /* the address never breaks in two */
  }

  /* About as tall as vega.io's own nav logo; width from the file's aspect. */
  .site-footer__vega {
    display: block;
    line-height: 0;
  }

  .site-footer__vega img {
    display: block;
    width: auto;
    height: 1.5rem;
  }
</style>
