---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = '16-Bit Con — October 3–5, 2026, Javits Center, New York',
  description =
    'The retro gaming convention for people who never stopped playing. October 3–5, 2026 at the Javits Center, New York. Find Vega at Booth 630.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Signifier-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFAEB" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="16-Bit Con, October 3–5, 2026, Javits Center, New York. Sam the mole flies over a daisy field." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Every load starts at the top of the world, scroll 0: the browser does not restore the old
      // scroll position, and a reload also drops a #section hash so it cannot jump there either.
      // A fresh visit to a link with a hash (/#register) still lands on its section.
      (function () {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var reload = !!nav && nav.type === 'reload';
        if (reload && location.hash) history.replaceState(null, '', location.pathname + location.search);
        if (location.hash) return;
        var top = function () { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); };
        top();
        window.addEventListener('DOMContentLoaded', top, { once: true });
        window.addEventListener('load', top, { once: true });
      })();
    </script>
    <script is:inline>
      // World art scale for DOM-placed world art (hero platform, Sam). Mirrors worldBuffer()
      // in src/game/scale.ts: k = clamp(round(deviceH / 540), 2, 6), 240 px width floor.
      (function () {
        var root = document.documentElement;
        function fit() {
          var dpr = window.devicePixelRatio || 1;
          var devW = Math.round(window.innerWidth * dpr);
          var devH = Math.round(window.innerHeight * dpr);
          var k = Math.min(6, Math.max(2, Math.round(devH / 540)));
          if (Math.ceil(devW / k) < 240) k = Math.max(2, k - 1);
          root.style.setProperty('--px', String(k / dpr));
        }
        fit();
        window.addEventListener('resize', fit, { passive: true });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p class="eyebrow">
        16-Bit Con · Oct 3–5, 2026 · Javits Center, New York · Find Vega at Booth 630 ·{' '}
        <a href="https://vega.io/16-bit-con">vega.io/16-bit-con</a>
      </p>
    </footer>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .site-footer {
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
  }
</style>
